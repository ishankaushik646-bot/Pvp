-- Option Pair mit Callback
local function makeOptionPair(parent, y, opt1, opt2, activeIdx, onSelect)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -20, 0, 20)
    row.Position = UDim2.fromOffset(10, y)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local function makeOptBtn(text, xScale, isActive)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0.5, -2, 1, 0)
        b.Position = UDim2.new(xScale, xScale == 0 and 0 or 2, 0, 0)
        b.BackgroundColor3 = isActive and C.btnActive or C.btnInactive
        b.BorderSizePixel = 0
        b.Text = text
        b.Font = Enum.Font.GothamBold
        b.TextSize = 9
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.AutoButtonColor = false
        b.Parent = row
        corner(b, 4)
        stroke(b, C.borderGlow, 1, 0.35)
        return b
    end

    local b1 = makeOptBtn(opt1, 0, activeIdx == 1)
    local b2 = makeOptBtn(opt2, 0.5, activeIdx == 2)

    local function select(idx)
        b1.BackgroundColor3 = idx == 1 and C.btnActive or C.btnInactive
        b2.BackgroundColor3 = idx == 2 and C.btnActive or C.btnInactive
        if onSelect then onSelect(idx) end
    end

    b1.MouseButton1Click:Connect(function() select(1) end)
    b2.MouseButton1Click:Connect(function() select(2) end)
    return b1, b2, select
end

local function makeTriple(parent, y, opts, activeIdx, onSelect)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -20, 0, 18)
    row.Position = UDim2.fromOffset(10, y)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local btns = {}
    for i, text in ipairs(opts) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1/3, -2, 1, 0)
        b.Position = UDim2.new((i-1)/3, (i-1 == 0 and 0 or 2), 0, 0)
        b.BackgroundColor3 = (i == activeIdx) and C.btnActive or C.btnInactive
        b.BorderSizePixel = 0
        b.Text = text
        b.Font = Enum.Font.GothamBold
        b.TextSize = 8
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.AutoButtonColor = false
        b.Parent = row
        corner(b, 4)
        stroke(b, C.borderGlow, 1, 0.35)
        btns[i] = b
    end

    for i, b in ipairs(btns) do
        b.MouseButton1Click:Connect(function()
            for j, other in ipairs(btns) do
                other.BackgroundColor3 = (j == i) and C.btnActive or C.btnInactive
            end
            if onSelect then onSelect(opts[i], i) end
        end)
    end
    return btns
end

