local FX = {}

FX.sakura = function(parent, count, z)
    count = count or 10
    for i = 1, count do
        local petal = Create("Frame", {
            Size = UDim2.new(0, 6, 0, 8),
            Position = UDim2.new(math.random(), 0, math.random(), 0),
            BackgroundColor3 = Color3.fromRGB(140 + i%5*20, 200 + i%3*15, 255),
            BackgroundTransparency = 0.3,
            BorderSizePixel = 0,
            Rotation = i * 30,
            ZIndex = z or 2,
            Parent = parent
        })
        Corner(petal, 4)

        task.spawn(function()
            local speed = 0.0025 + i%5 * 0.001
            while petal and petal.Parent do
                local y = petal.Position.Y.Scale + speed
                local x = petal.Position.X.Scale + math.sin(tick() + i) * 0.002
                if y > 1.08 then
                    y = -0.05
                    x = math.random() * 0.95
                end
                petal.Position = UDim2.new(math.clamp(x, -0.05, 1), 0, y, 0)
                petal.Rotation = petal.Rotation + 0.8
                task.wait(0.03)
            end
        end)
    end
end

FX.shadow = function(parent, size, transparency)
    return Create("ImageLabel", {
        Name = "Shadow",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 4),
        Size = UDim2.new(1, size or 36, 1, size or 36),
        BackgroundTransparency = 1,
        Image = "rbxassetid://6014261993",
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = transparency or 0.4,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        ZIndex = math.max(0, (parent.ZIndex or 1) - 1),
        Parent = parent
    })
end

FX.ripple = function(btn)
    btn.ClipsDescendants = true
    btn.MouseButton1Click:Connect(function()
        local ripple = Create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = ColorWhite,
            BackgroundTransparency = 0.6,
            BorderSizePixel = 0,
            ZIndex = 30,
            Parent = btn
        })
        Corner(ripple, 99)
        Tween(ripple, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(1.6, 0, 1.6, 0),
            BackgroundTransparency = 1
        })
        task.delay(0.5, function()
            if ripple then ripple:Destroy() end
        end)
    end)
end

FX.shake = function(obj, intensity, times)
    if not obj or not obj.Parent then return end
    intensity = intensity or 3
    times = times or 4
    local original = obj.Position
    task.spawn(function()
        for i = 1, times do
            obj.Position = UDim2.new(
                original.X.Scale,
                original.X.Offset + (math.random()-0.5)*2*intensity,
                original.Y.Scale,
                original.Y.Offset + (math.random()-0.5)*2*intensity
            )
            task.wait(0.02)
        end
        obj.Position = original
    end)
end

FX.strokeFlash = function(stroke, thickness, transparency)
    if not stroke then return end
    local oldT = stroke.Thickness
    local oldTr = stroke.Transparency
    stroke.Thickness = thickness or oldT + 2.5
    stroke.Transparency = transparency or 0.05
    Tween(stroke, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Thickness = oldT,
        Transparency = oldTr
    })
end

FX.press = function(parent)
    local scale = parent:FindFirstChildOfClass("UIScale")
    if not scale then
        scale = Instance.new("UIScale")
        scale.Scale = 1
        scale.Parent = parent
    end
    scale.Scale = 0.92
    Tween(scale, TweenBack, {Scale = 1})
end

FX.clickFX = function(btn, stroke)
    FX.ripple(btn)
    btn.MouseButton1Click:Connect(function()
        FX.press(btn)
        FX.shake(btn, 2.5, 4)
        if stroke then FX.strokeFlash(stroke, 3, 0.05) end
    end)
    btn.MouseEnter:Connect(function()
        if stroke then
            Tween(stroke, TweenFast, {Transparency = 0.2, Thickness = stroke.Thickness < 2 and 1.6 or stroke.Thickness})
        end
    end)
    btn.MouseLeave:Connect(function()
        if stroke then
            Tween(stroke, TweenFast, {Transparency = 0.5, Thickness = 1.2})
        end
    end)
end

