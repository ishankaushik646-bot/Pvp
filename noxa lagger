-- Phone drag
do
    local dragging, startPos, startFrame
    local function begin(inp)
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        startPos = inp.Position
        startFrame = Phone.Position
    end
    Header.InputBegan:Connect(begin)
    Phone.InputBegan:Connect(begin)
    UserInputService.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = inp.Position - startPos
        Phone.Position = UDim2.new(startFrame.X.Scale, startFrame.X.Offset + delta.X, startFrame.Y.Scale, startFrame.Y.Offset + delta.Y)
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                Config.posSX = Phone.Position.X.Scale
                Config.posOX = Phone.Position.X.Offset
                Config.posSY = Phone.Position.Y.Scale
                Config.posOY = Phone.Position.Y.Offset
                SaveConfig()
            end
        end
    end)
end

