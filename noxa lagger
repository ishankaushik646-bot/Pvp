local function makeToggle(parent, posX, posY, initial, onChanged)
    local track = Instance.new("Frame")
    track.Size = UDim2.fromOffset(26, 14)
    track.Position = UDim2.new(1, posX, 0, posY)
    track.BackgroundColor3 = initial and C.trackOn or C.trackOff
    track.BorderSizePixel = 0
    track.Parent = parent
    corner(track, 7)
    stroke(track, C.borderGlow, 1, 0.5)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(10, 10)
    knob.Position = initial and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
    knob.BackgroundColor3 = C.knob
    knob.BorderSizePixel = 0
    knob.Parent = track
    corner(knob, 5)

    local state = initial
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = track
    btn.MouseButton1Click:Connect(function()
        state = not state
        track.BackgroundColor3 = state and C.trackOn or C.trackOff
        knob.Position = state and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
        if onChanged then onChanged(state) end
    end)
    return track, function(newState)
        state = newState
        track.BackgroundColor3 = state and C.trackOn or C.trackOff
        knob.Position = state and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
    end
end

