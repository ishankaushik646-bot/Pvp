local GREEN = Color3.fromRGB(239, 68, 68)
local GREY  = Color3.fromRGB(55, 55, 68)

local function setToggleVisual(track, knob, enabled, instant)
    local targetPos   = enabled and UDim2.new(0, 25, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    local targetColor = enabled and GREEN or GREY
    if instant then
        knob.Position = targetPos
        track.BackgroundColor3 = targetColor
    else
        TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = targetPos }):Play()
        TweenService:Create(track, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { BackgroundColor3 = targetColor }):Play()
    end
end

local Keybinds = { PCLagger = nil, LowPower = nil }

local function keyDisplay(k)
    if not k then return "NONE" end
    return tostring(k):gsub("Enum.KeyCode.", "")
end

local function listenForKey(btn, slot)
    local oldText = btn.Text
    btn.Text = "..."
    btn.TextColor3 = Color3.fromRGB(255, 180, 180)

    local conn
    conn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if input.KeyCode == Enum.KeyCode.Unknown then return end
        if input.KeyCode == Enum.KeyCode.Escape then
            btn.Text = oldText
            btn.TextColor3 = Color3.fromRGB(200, 200, 210)
            conn:Disconnect()
            return
        end
        Keybinds[slot] = input.KeyCode
        btn.Text = keyDisplay(input.KeyCode)
        btn.TextColor3 = Color3.fromRGB(200, 200, 210)
        conn:Disconnect()
    end)

    task.delay(5, function()
        if conn then
            pcall(function() conn:Disconnect() end)
            if btn.Text == "..." then
                btn.Text = oldText
                btn.TextColor3 = Color3.fromRGB(200, 200, 210)
            end
        end
    end)
end

