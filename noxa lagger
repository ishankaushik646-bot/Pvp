local function ApplyTheme(theme)
    if not theme then return end
    Accent = theme.accent
    A2 = theme.a2
    Config.themeName = theme.name

    for _, t in ipairs(AccentTargets) do
        pcall(function()
            if t.inst and t.inst.Parent then
                t.inst[t.prop] = Accent
            end
        end)
    end

    pcall(function()
        InnerStroke.Color = Accent
        CustStroke.Color = Accent
        Title.TextColor3 = Accent
        FloatTitle.TextColor3 = Accent
        if FloatStroke then FloatStroke.Color = Accent end
        if BgImage then
            BgImage.ImageColor3 = Color3.fromRGB(
                math.clamp(math.floor(theme.accent.R * 180 + 70), 0, 255),
                math.clamp(math.floor(theme.accent.G * 140 + 60), 0, 255),
                math.clamp(math.floor(theme.accent.B * 160 + 90), 0, 255)
            )
        end
        if BillGrad then
            BillGrad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Accent),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 120, 220)),
                ColorSequenceKeypoint.new(1, Accent)
            })
        end
        SyncFloatBg()
        UpdateActivateVisual()
        UpdateVersionButtons()
        SyncFloat()
    end)
    SaveConfig()
end

