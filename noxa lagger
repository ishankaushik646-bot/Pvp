local function setPCLagger(state)
    if state == LaggerState.Main then
        setToggleVisual(Track, Knob, state, true)
        return
    end
    if state and LaggerState.LowEnd then
        stopLowEnd()
        setToggleVisual(Track_2, Knob_2, false)
    end
    if state then
        startMain()
    else
        stopMain()
    end
    setToggleVisual(Track, Knob, state)
end

