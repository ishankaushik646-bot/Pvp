task.spawn(function()
    while StatusOuter and StatusOuter.Parent do
        local pulse = (math.sin(tick() * 1.8) + 1) * 0.5
        local activeMul = Config.active and 1 or 0
        StatusStroke.Transparency = 0.55 - pulse * 0.25 - activeMul * 0.12
        StatusStroke.Thickness = 2.2 + pulse * 0.8 + activeMul * 1
        StatusStroke.Color = Accent
        local size = 120 + pulse * 6 + activeMul * 8
        GlowRing.Size = UDim2.fromOffset(size, size)
        GlowStroke.Transparency = 0.9 - pulse * 0.15 - activeMul * 0.1
        GlowStroke.Color = Accent
        if AccentLine then
            AccentLine.BackgroundTransparency = 0.1 + (1 - pulse) * 0.2
            AccentLine.Size = UDim2.new(0.78 + pulse * 0.04, 0, 0, 1.5)
        end
        VersionScale.Scale = 1 + pulse * 0.025 + activeMul * 0.04
        task.wait(0.04)
    end
end)

