local listeningKey = false
KeybindBtn.MouseButton1Click:Connect(function()
    if listeningKey then return end
    listeningKey = true
    KeybindBtn.Text = "[...]"
    KeybindBtn.TextColor3 = Accent
end)

UserInputService.InputBegan:Connect(function(inp, gpe)
    if listeningKey then
        if gpe then return end
        if inp.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode ~= Enum.KeyCode.Unknown then
            Config.keybind = inp.KeyCode
            listeningKey = false
            KeybindBtn.Text = "[" .. Config.keybind.Name .. "]"
            KeybindBtn.TextColor3 = ColorMuted
            SaveConfig()
        end
        return
    end
    if gpe then return end
    if inp.KeyCode == Config.keybind then
        DoToggle()
    end
end)

