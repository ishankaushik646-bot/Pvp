----------------------------------------------------------------
-- Customize open/close
----------------------------------------------------------------
local custOpen = false
local function FadeCust(alpha, info)
    Tween(Customize, info, {BackgroundTransparency = alpha})
    Tween(CustStroke, info, {Transparency = 0.35 + alpha * 0.65})
    for _, d in ipairs(Customize:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            Tween(d, info, {TextTransparency = alpha})
        end
    end
end

local function OpenCustomize()
    if custOpen then return end
    custOpen = true
    Customize.Visible = true
    Customize.Position = UDim2.new(CustPos.X.Scale, CustPos.X.Offset - 18, CustPos.Y.Scale, CustPos.Y.Offset + 26)
    CustScale.Scale = Config.customizeScale * 0.78
    FadeCust(1, TweenInfo.new(0))
    FadeCust(0, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
    Tween(CustScale, TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = Config.customizeScale})
    Tween(Customize, TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = CustPos})
end

local function CloseCustomize()
    if not custOpen then return end
    custOpen = false
    Tween(CustScale, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Scale = Config.customizeScale * 0.8})
    Tween(Customize, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
        Position = UDim2.new(CustPos.X.Scale, CustPos.X.Offset + 14, CustPos.Y.Scale, CustPos.Y.Offset + 20)
    })
    FadeCust(1, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In))
    task.delay(0.26, function()
        if not custOpen then
            Customize.Visible = false
            Customize.Position = CustPos
        end
    end)
end

CloseCust.MouseButton1Click:Connect(CloseCustomize)

local function ToggleCustomize()
    if custOpen then CloseCustomize() else OpenCustomize() end
end

BgBtn.MouseButton1Click:Connect(function()
    Tween(BgScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad), {Scale = 0.92})
    task.delay(0.12, function() Tween(BgScale, TweenBack, {Scale = 1}) end)
    ToggleCustomize()
end)

