local function destroy()
	if not runtime.alive then return end
	runtime.alive = false
	runtime.enabled = false
	runtime.awaitingKey = false
	runtime.captureGeneration += 1

	stopStepConnection()
	restoreReplicationRoot()
	destroyFakeRoot()

	for _, connection in ipairs(runtime.connections) do
		disconnect(connection)
	end
	table.clear(runtime.connections)

	for i = #runtime.settingsRestore, 1, -1 do
		local entry = runtime.settingsRestore[i]
		pcall(function() entry.instance[entry.property] = entry.value end)
	end
	table.clear(runtime.settingsRestore)

	if fa4e7xxAntiTPUI then
		pcall(function() fa4e7xxAntiTPUI:Destroy() end)
	end

	if environment[RUNTIME_KEY] == runtime then
		environment[RUNTIME_KEY] = nil
	end
end

