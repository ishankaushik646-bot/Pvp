local function updateToggleVisual()
	local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	if runtime.enabled then
		Status.Text = "ON"
		Status.TextColor3 = Color3.fromRGB(0, 220, 120)
		TweenService:Create(Toggle, tweenInfo, {BackgroundColor3 = Color3.fromRGB(0, 140, 255)}):Play()
		TweenService:Create(Knob, tweenInfo, {Position = UDim2.new(1, -17, 0, 3)}):Play()
	else
		Status.Text = "OFF"
		Status.TextColor3 = Color3.fromRGB(130, 150, 200)
		TweenService:Create(Toggle, tweenInfo, {BackgroundColor3 = Color3.fromRGB(40, 50, 80)}):Play()
		TweenService:Create(Knob, tweenInfo, {Position = UDim2.new(0, 3, 0, 3)}):Play()
	end
end

local function setEnabled(value)
	if not runtime.alive then return false end
	value = value == true
	if runtime.enabled == value then
		updateToggleVisual()
		return value
	end

	runtime.enabled = value
	updateToggleVisual()

	if value then
		local root = getCurrentRoot(runtime.character)
		runtime.rootPart = root
		if not root then
			runtime.enabled = false
			updateToggleVisual()
			return false
		end
		local fake = createFakeRoot(root)
		assignFakeReplicationRoot(root, fake)
		startStepConnection()
	else
		stopStepConnection()
		restoreReplicationRoot()
		destroyFakeRoot()
	end
	return runtime.enabled
end

local function toggleEnabled()
	return setEnabled(not runtime.enabled)
end

