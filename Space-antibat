-- // [4] FUNCTIONAL LOGIC & SIGNAL CONNECTIONS // --
local antiBatConnection
local infJumpConnection

local function updateStatus(active)
    if active then
        StatusValue.Text = "ACTIVE"
        StatusValue.TextColor3 = CONFIG.Colors.StatusActive
        StatusDot.BackgroundColor3 = CONFIG.Colors.StatusActive
    else
        StatusValue.Text = "INACTIVE"
        StatusValue.TextColor3 = CONFIG.Colors.StatusInactive
        StatusDot.BackgroundColor3 = CONFIG.Colors.StatusInactive
    end
end

local function setToggleVisual(bg, dot, enabled)
    if enabled then
        bg.BackgroundColor3 = CONFIG.Colors.ToggleOn
        TweenService:Create(dot, TweenInfo.new(0.15), {Position = UDim2.new(1, -19, 0.5, -8)}):Play()
    else
        bg.BackgroundColor3 = CONFIG.Colors.ToggleOff
        TweenService:Create(dot, TweenInfo.new(0.15), {Position = UDim2.new(0, 3, 0.5, -8)}):Play()
    end
end

local function toggleAntiBat()
    State.AntiBatEnabled = not State.AntiBatEnabled
    setToggleVisual(ToggleBg, ToggleDot, State.AntiBatEnabled)
    updateStatus(State.AntiBatEnabled or State.InfJumpEnabled)

    if antiBatConnection then
        antiBatConnection:Disconnect()
        antiBatConnection = nil
    end

    if State.AntiBatEnabled then
        antiBatConnection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local vel = hrp.Velocity
                if vel.Magnitude > 50 then
                    hrp.Velocity = Vector3.new(vel.X * 0.1, vel.Y, vel.Z * 0.1)
                end
            end
        end)
    end
end

local function toggleInfJump()
    State.InfJumpEnabled = not State.InfJumpEnabled
    setToggleVisual(InfToggleBg, InfToggleDot, State.InfJumpEnabled)
    updateStatus(State.AntiBatEnabled or State.InfJumpEnabled)

    if infJumpConnection then
        infJumpConnection:Disconnect()
        infJumpConnection = nil
    end

    if State.InfJumpEnabled then
        infJumpConnection = UserInputService.JumpRequest:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end

local function setBackground(imageId)
    State.CurrentBackground = imageId
    if SpaceBackground then
        SpaceBackground.Image = imageId
    end
end

local function openBackgroundPicker()
    BackgroundPicker.Visible = true
    State.BackgroundPickerOpen = true
end

local function closeBackgroundPicker()
    BackgroundPicker.Visible = false
    State.BackgroundPickerOpen = false
end

local function minimizeToggle()
    State.Minimized = not State.Minimized
    ContentHolder.Visible = not State.Minimized
    if State.Minimized then
        Main.Size = UDim2.new(0, 220, 0, 48)
        MinBtn.Text = "+"
    else
        Main.Size = CONFIG.Size.Main
        MinBtn.Text = "-"
    end
end

local function makeDraggable(frame)
    local dragging, dragInput, dragStart, startPos

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

local function connectEvents()
    MinBtn.MouseButton1Click:Connect(minimizeToggle)

    BgBtn.MouseButton1Click:Connect(openBackgroundPicker)
    CloseBtn.MouseButton1Click:Connect(closeBackgroundPicker)

    DefaultBtn.MouseButton1Click:Connect(function()
        setBackground(CONFIG.Images.Default)
        closeBackgroundPicker()
    end)
    Space1Btn.MouseButton1Click:Connect(function()
        setBackground(CONFIG.Images.Space1)
        closeBackgroundPicker()
    end)
    Space2Btn.MouseButton1Click:Connect(function()
        setBackground(CONFIG.Images.Space2)
        closeBackgroundPicker()
    end)

    AntiBatClick.MouseButton1Click:Connect(toggleAntiBat)
    InfJumpClick.MouseButton1Click:Connect(toggleInfJump)

    KeybindBtn.MouseButton1Click:Connect(function()
        KeybindBtn.Text = "..."
        local conn
        conn = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                CONFIG.Keybind = input.KeyCode
                KeybindBtn.Text = input.KeyCode.Name
                conn:Disconnect()
            end
        end)
    end)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == CONFIG.Keybind then
            if ScreenGui then
                ScreenGui.Enabled = not ScreenGui.Enabled
            end
        end
    end)

    local function hoverEffect(btn, enterColor, leaveColor)
        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = enterColor}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = leaveColor}):Play()
        end)
    end

    hoverEffect(BgBtn, Color3.fromRGB(40, 40, 45), CONFIG.Colors.BgBtn)
    hoverEffect(MinBtn, Color3.fromRGB(30, 30, 35), CONFIG.Colors.MinBtn)
end

-- // [5] INITIALIZATION // --
local function init()
    createGUI()
    makeDraggable(Main)
    connectEvents()

    setToggleVisual(ToggleBg, ToggleDot, false)
    setToggleVisual(InfToggleBg, InfToggleDot, false)
    updateStatus(false)
end

