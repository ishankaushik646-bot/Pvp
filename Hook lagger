local currentKeybind = Enum.KeyCode.V
local currentControllerKeybind = Enum.KeyCode.ButtonY
local keybindType = "keyboard" -- "keyboard" or "controller"

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    
    -- Toggle UI visibility
    if input.KeyCode == Enum.KeyCode.LeftControl then 
        mainFrame.Visible = not mainFrame.Visible 
    end
    
    -- Listening for keybind input
    if listening then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            currentKeybind = input.KeyCode
            keybindType = "keyboard"
            keybindButton.Text = input.KeyCode.Name:sub(1,1)
            listening = false
        elseif input.UserInputType == Enum.UserInputType.Gamepad1 then
            currentControllerKeybind = input.KeyCode
            keybindType = "controller"
            local btnName = input.KeyCode.Name:gsub("Button", ""):sub(1,1)
            keybindButton.Text = btnName
            listening = false
        end
    end
    
    -- Toggle lagger
    if keybindType == "keyboard" and input.KeyCode == currentKeybind then
        toggleLagger(not laggerEnabled)
    elseif keybindType == "controller" and input.KeyCode == currentControllerKeybind then
        toggleLagger(not laggerEnabled)
    end
end)

