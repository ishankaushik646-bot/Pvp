-- ================================================
-- SPEED SETTINGS (Edit these)
-- ================================================

local NORMAL_SPEED = 64     -- Normal walking speed
local CARRY_SPEED = 30      -- Speed when carrying (WalkSpeed < 25)

-- ================================================
-- CORE SPEED LOGIC
-- ================================================

local char = player.Character or player.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local hum = char:WaitForChild("Humanoid")

local currentSpeed = NORMAL_SPEED
local speedOn = false

local bodyForce = Instance.new("BodyForce")
bodyForce.Force = Vector3.new(0, 0, 0)
bodyForce.Parent = root

local function isCarrying()
    return hum.WalkSpeed < 25 and hum.WalkSpeed > 0
end

local function updateSpeed()
    if not speedOn then return end
    
    local moveDir = hum.MoveDirection
    if moveDir.Magnitude > 0.1 then
        -- Auto-switch between normal and carry
        local targetSpeed = isCarrying() and CARRY_SPEED or NORMAL_SPEED
        currentSpeed = targetSpeed
        
        local currentVel = root.AssemblyLinearVelocity
        local targetVel = moveDir * currentSpeed
        local diff = targetVel - currentVel
        local mass = root:GetMass() or 2
        local forceAmount = diff * mass / 0.016
        forceAmount = Vector3.new(forceAmount.X, 0, forceAmount.Z)
        bodyForce.Force = forceAmount
    else
        bodyForce.Force = Vector3.new(0, 0, 0)
    end
end

local function startSpeed()
    if speedOn then return end
    speedOn = true
    bodyForce.Force = Vector3.new(0, 0, 0)
end

local function stopSpeed()
    speedOn = false
    bodyForce.Force = Vector3.new(0, 0, 0)
end

