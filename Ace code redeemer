                recentAIDetails[searchIndex]=aiDetails[unresolvedIndex]
            end
            local webValues,webDetails,webError=solveWithLookupProxy(recentItems,recentMeta,recentAIValues,recentAIDetails)
            if webValues then
                local acceptedAny=false
                for searchIndex,unresolvedIndex in ipairs(recentPositions)do
                    local webValue=webValues[searchIndex]
                    local detail=webDetails and webDetails[searchIndex]or nil
                    if isUsableAnswer(webValue)then
                        aiValues[unresolvedIndex]=webValue
                        aiDetails[unresolvedIndex]=detail or{reason="accepted_search"}
                        webReplaced[unresolvedIndex]=true
                        usedLiveSearch=true
                        acceptedAny=true
                    else
                        local candidate=detail and detail.candidateAnswer or nil
                        if not isUsableAnswer(candidate)then candidate=recentAIValues[searchIndex]end
                        if isUsableAnswer(candidate)
                            and GROUP_ACCESS.reviewCandidateSafe(searchItem,candidate)
                            and not STATE._lastReviewCandidate then
                            STATE._lastReviewCandidate=tostring(candidate)
                            STATE._lastReviewMeta={
                                reason=detail and tostring(detail.reason or"search_unresolved")or"search_unresolved",
                                confidence=tonumber(detail and(detail.candidateConfidence or detail.confidence))
                                    or tonumber(recentAIDetails[searchIndex]and recentAIDetails[searchIndex].confidence)or 0,
                                route=detail and tostring(detail.route or"REVIEW")or"REVIEW",
                                sourceCount=tonumber(detail and detail.sourceCount)or 0,
                                highestTier=tonumber(detail and detail.highestTier)or 4,
                            }
                        end
                        aiValues[unresolvedIndex]="UNKNOWN"
                        aiDetails[unresolvedIndex]=detail or{reason="search_unresolved",confidence=0}
                    end
                end
                GROUP_ACCESS.solverLog("SEARCH_OK",formatResolverTrace(
                    (function()
                        local r={}
                        for i=1,#webValues do r[i]=isUsableAnswer(webValues[i])and"WEB"or"UNKNOWN"end
                        return r
                    end)(),webValues
                ))
                if not acceptedAny then
                    local firstDetail=webDetails and webDetails[1]or nil
                    STATE._lastSearchError=firstDetail and tostring(firstDetail.reason or"search_returned_no_usable_answer")
                        or"search_returned_no_usable_answer"
                end
            else
                STATE._lastSearchError=tostring(webError or"lookup_failed")
                GROUP_ACCESS.solverLog("SEARCH_FAIL",STATE._lastSearchError)
                for searchIndex,unresolvedIndex in ipairs(recentPositions)do
                    local prior=recentAIValues[searchIndex]
                    if isUsableAnswer(prior)and not STATE._lastReviewCandidate then
                        STATE._lastReviewCandidate=tostring(prior)
                        STATE._lastReviewMeta={reason=tostring(webError or"search_failed"),confidence=tonumber(recentAIDetails[searchIndex]and recentAIDetails[searchIndex].confidence)or 0,route="AI_CANDIDATE"}
                    end
                    aiValues[unresolvedIndex]="UNKNOWN"
                    aiDetails[unresolvedIndex]={reason="search_failed",confidence=0}
                end
            end
        end
    end
    for answerIndex,originalIndex in ipairs(unresolvedIndexes)do
        local value=aiValues[answerIndex]
        results[originalIndex]=value
        local detail=aiDetails and aiDetails[answerIndex]
        if not isUsableAnswer(value)then
            routes[originalIndex]="UNKNOWN"
            if detail and detail.reason then STATE._lastFinalError=tostring(detail.reason)end
        elseif webReplaced[answerIndex]then
            routes[originalIndex]=detail and tostring(detail.route or"WEB")or"WEB"
        else
            routes[originalIndex]="AI"
        end
    end
    for index=1,#items do
        if not results[index]then
            STATE._lastFinalError="missing_result_slot"
            return nil,usedLiveSearch and"Live lookup"or"Nemotron AI",formatResolverTrace(routes,results),true
        end
    end
    local resolverTrace=formatResolverTrace(routes,results)
    local hasUnknown=resultsContainUnknown(results)
    if hasUnknown then
        if not STATE._lastFinalError then STATE._lastFinalError="unresolved_answer"end
        GROUP_ACCESS.solverLog("NEEDS_REVIEW",resolverTrace.." • "..GROUP_ACCESS.resolverErrorSummary())
        return nil,usedLiveSearch and"Live lookup"or"Nemotron AI",resolverTrace,true
    end
    local complete=table.concat(results)
    GROUP_ACCESS.solverLog("FINAL",resolverTrace.." => "..tostring(complete))
    return complete,usedLiveSearch and"Live lookup"or"Nemotron AI",resolverTrace,false
end
