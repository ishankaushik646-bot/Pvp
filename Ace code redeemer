            if candidate~= ""and#candidate<=800 then candidates[#candidates+1]=candidate end
        elseif valueType=="table"and not visited[value]then
            visited[value]=true
            for _,nested in pairs(value)do collect(nested,depth+1)end
        end
    end
    for index=1,select("#",...)do collect(select(index,...),0)end
    table.sort(candidates,function(a,b)return#a>#b end)
    local message=candidates[1]
    if not message then return end
    if sourceName=="SCREEN"and isScreenNoiseText(message)then
        pcall(function()handleRedemptionConfirmation(message,nil)end)
        GROUP_ACCESS.solverLog("SCREEN_IGNORE",tostring(message):sub(1,120))
        return
    end
    if sourceName=="REMOTE-PROBE"and not shouldUseAI(message)then return end
    local key=normalizeQuestion(aceStripRich(message))
    local now=os.clock()
    if key~= ""and STATE.announcementSeen[key]and now-STATE.announcementSeen[key]<=1.5 then return end
    if key~= ""then
        STATE.announcementSeen[key]=now
        task.delay(1.6,function()if STATE.announcementSeen[key]==now then STATE.announcementSeen[key]=nil end end)
    end
    setStatus("Captured ["..tostring(sourceName or"UNKNOWN").."]: "..message:sub(1,110),UI.COLORS.White)
    local ok,failure=xpcall(function()processAnnouncement(message,sourceName)end,function(err)
        return debug and debug.traceback and debug.traceback(tostring(err),2)or tostring(err)
    end)
    if not ok then setStatus("[Announcement Error] "..tostring(failure),UI.COLORS.Red)end
end
