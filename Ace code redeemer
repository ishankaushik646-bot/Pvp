    local raw=tostring(candidate or"")
    local split=raw:gsub("(%l)(%u)","%1 %2"):gsub("(%a)(%d)","%1 %2"):gsub("(%d)(%a)","%1 %2")
    local q=normalizeQuestion(question)
    local a=normalizeQuestion(split)
    if a== ""or a=="unknown"then return false end
    local answerTokens,questionTokens={},{}
    for token in a:gmatch("[a-z0-9]+")do answerTokens[#answerTokens+1]=token end
    for token in q:gmatch("[a-z0-9]+")do questionTokens[token]=true end
    if#answerTokens>=2 then
        local overlap=0
        for _,token in ipairs(answerTokens)do
            if questionTokens[token]then overlap+=1 end
        end
        if overlap/#answerTokens>=0.80 then return false end
    end
    if q:find("rebirth",1,true)and not raw:match("%d")then return false end
    return true
end
