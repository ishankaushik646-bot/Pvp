    local function makeSelector(row,choices,selected,onChanged)
        local width=math.min(230,68*#choices)
        local shell=Instance.new("Frame")
        shell.Size=UDim2.fromOffset(width,22)
        shell.Position=UDim2.new(1,-(width+10),0.5,-11)
        shell.BackgroundTransparency=1
        shell.ZIndex=4
        shell.Parent=row
        local buttons={}
        local selectedValue=selected
        local buttonWidth=math.floor(shell.Size.X.Offset/#choices)
        local function render()
            for value,button in pairs(buttons)do
                local active=value==selectedValue
                button.BackgroundColor3=active and UI.COLORS.Accent or UI.COLORS.Control
                button.TextColor3=active and UI.COLORS.White or UI.COLORS.Dim
            end
        end
        for index,choice in ipairs(choices)do
            local choiceValue,choiceLabel=choice.value,choice.label
            local button=Instance.new("TextButton")
            button.Name=choiceValue
            button.Size=UDim2.fromOffset(buttonWidth-2,22)
            button.Position=UDim2.fromOffset((index-1)*buttonWidth,0)
            button.BackgroundColor3=UI.COLORS.Control
            button.BorderSizePixel=0
            button.AutoButtonColor=false
            button.Text=choiceLabel
            button.TextSize=#choiceLabel>10 and 7 or 8
            button.TextColor3=UI.COLORS.Dim
            button.Font=Enum.Font.GothamBold
            button.ZIndex=5
            button.Parent=shell
            UI.addCorner(button,5)
            buttons[choiceValue]=button
            button.Activated:Connect(function()
                if selectedValue==choiceValue then return end
                selectedValue=choiceValue
                render()
                onChanged(selectedValue)
            end)
        end
        render()
        local function selectValue(value,triggerChange)
            if not buttons[value]then return false end
            local changed=selectedValue~=value
            selectedValue=value
            render()
            if changed and triggerChange~=false then onChanged(selectedValue)end
            return true
        end
        return shell,selectValue
    end
