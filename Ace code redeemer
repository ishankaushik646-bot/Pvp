local function screenObjectLooksLikeAnnouncement(object,text)
    if not(object:IsA("TextLabel")or object:IsA("TextButton"))or isOurGui(object)then return false,"OBJECT"end
    if not isVisibleChain(object)then return false,"HIDDEN"end
    local names={}
    local current=object
    for _=1,6 do
        if not current then break end
        names[#names+1]=current.Name:lower()
        current=current.Parent
    end
    local path=table.concat(names," ")
    if path:find("chat",1,true)or path:find("playerlist",1,true)
        or path:find("people",1,true)or path:find("leaderboard",1,true)
        or path:find("nameplate",1,true)or path:find("currency",1,true)
        or path:find("cash",1,true)or path:find("money",1,true)
        or path:find("votes",1,true)or path:find("counter",1,true)
        or path:find("timer",1,true)then return false,"PATH_NOISE"end
    text=trim(aceStripRich(text or object.Text or""))
    if text== ""or#text<3 or#text>600 then return false,"TEXT_LENGTH"end
    local prominent=false
    local inQuizRegion=false
    pcall(function()
        prominent=object.TextScaled or object.TextSize>=18 or object.AbsoluteSize.X>=220
        local camera=workspace.CurrentCamera
        local viewport=camera and camera.ViewportSize or Vector2.new(1920,1080)
        local centerX=(object.AbsolutePosition.X+object.AbsoluteSize.X*0.5)/math.max(1,viewport.X)
        local topY=object.AbsolutePosition.Y/math.max(1,viewport.Y)
        inQuizRegion=centerX>=0.18 and centerX<=0.82 and topY<=0.42
    end)
    return screenTextDecision(text,path,prominent,inQuizRegion)
end
local function ingestScreenText(object)
    if not STATE._enabled then return end
    local rawText=trim(aceStripRich(object.Text or""))
    local accepted,reason,cleaned=screenObjectLooksLikeAnnouncement(object,rawText)
    if not accepted then return end
    local token={}
    STATE.screenPendingObjects[object]=token
    task.delay(0.08,function()
        if STATE.screenPendingObjects[object]~=token or not object.Parent or not isVisibleChain(object)then return end
        local currentRaw=trim(aceStripRich(object.Text or""))
        local stillAccepted,stillReason,currentCleaned=screenObjectLooksLikeAnnouncement(object,currentRaw)
        if not stillAccepted or currentCleaned~=cleaned or stillReason~=reason then return end
        local now=os.clock()
        if STATE.screenSeenText[cleaned]and now-STATE.screenSeenText[cleaned]<=1.25 then return end
        STATE.screenSeenText[cleaned]=now
        task.delay(1.3,function()
            if STATE.screenSeenText[cleaned]==now then STATE.screenSeenText[cleaned]=nil end
        end)
        GROUP_ACCESS.solverLog("SCREEN_ACCEPT",tostring(reason).." • "..tostring(cleaned):sub(1,100))
        onAceAnnouncement("SCREEN",cleaned)
    end)
end
local function watchScreenObject(object,ingestExisting)
    if not(object:IsA("TextLabel")or object:IsA("TextButton"))or isOurGui(object)then return end
    STATE.screenSeenText.__watched=STATE.screenSeenText.__watched or setmetatable({},{__mode="k"})
    if STATE.screenSeenText.__watched[object]then return end
    STATE.screenSeenText.__watched[object]=true
    if ingestExisting then ingestScreenText(object)end
    STATE.screenDetectionConnections[#STATE.screenDetectionConnections+1]=object:GetPropertyChangedSignal("Text"):Connect(function()
        ingestScreenText(object)
    end)
end
