function GROUP_ACCESS.shouldUseLiveSearch(question)
    local q=normalizeQuestion(question)
    if q== ""then return false end
    local phrases={
        "newest","latest","most recent","recently","recent",
        "right now","currently","current","today","yesterday",
        "this week","this month","this update","latest update",
        "recent update","new update","what changed","just added",
        "newly added","added in","added to","added during",
        "was added","were added","got added","introduced in",
        "introduced during","was introduced","removed in",
        "removed during","was removed","new gear","new brainrot",
        "new rebirth","new npc","new machine","new item",
        "limited brainrot","update","patch",
    }
    for _,phrase in ipairs(phrases)do
        if q:find(phrase,1,true)then return true end
    end
    local sabContext=q:find("steal a brainrot",1,true)
        or q:find("steal a brain rot",1,true)
        or containsWholeWord(q,"sab")
        or q:find("admin abuse",1,true)
        or q:find("brainrot",1,true)
    if sabContext then
        local changeWords={" added "," introduced "," removed "," released "," debuted "," during "}
        for _,word in ipairs(changeWords)do
            if(" "..q.." "):find(word,1,true)then return true end
        end
        local months={
            "january","february","march","april","may","june",
            "july","august","september","october","november","december",
        }
        local hasMonth=false
        for _,month in ipairs(months)do
            if containsWholeWord(q,month)then hasMonth=true;break end
