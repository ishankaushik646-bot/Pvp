local function resolveNotifyRemote()
    if _G.PhiNotifyRemote then return _G.PhiNotifyRemote end
    local packages=ReplicatedStorage:FindFirstChild("Packages")
    local Net=packages and packages:FindFirstChild("Net")
    local searchRoot=Net or ReplicatedStorage
    local remoteEvents={}
    for _,d in ipairs(searchRoot:GetDescendants())do
        if d:IsA("RemoteEvent")then
            remoteEvents[#remoteEvents+1]=d
            local path=(d:GetFullName().." "..d.Name):lower()
            if path:find("notif",1,true)or path:find("announce",1,true)
                or path:find("broadcast",1,true)or path:find("globalmessage",1,true)
                or path:find("servermessage",1,true)then
                return d
            end
        end
    end
    if getgc and debug and(debug.getinfo or debug.info)and getconnections then
        for _,d in ipairs(remoteEvents)do
            if d:IsA("RemoteEvent")then
                local ok,cs=pcall(getconnections,d.OnClientEvent)
                if ok then
                    for _,c in ipairs(cs)do
                        local f,fn=pcall(function()return c.Function end)
                        if f and type(fn)=="function"then
                            local source=""
                            if debug.getinfo then
                                local i,info=pcall(debug.getinfo,fn)
                                if i and type(info)=="table"then source=tostring(info.short_src or info.source or"")end
                            elseif debug.info then
                                local i,info=pcall(debug.info,fn,"s")
                                if i then source=tostring(info or"")end
                            end
                            if source:find("NotificationController",1,true)then
                                return d
                            end
                        end
                    end
                end
            end
        end
    end
    if#remoteEvents==1 then return remoteEvents[1]end
    return nil
end
