end
local function isScreenNoiseText(text)
    local raw=sanitizeScreenQuestionText(text)
    local lower=normalizeQuestion(raw)
    if lower== ""then return true end
    local containsNoise={
        "invalid code","code is invalid","please wait before trying to redeem another code",
        "wait before trying to redeem another code","already redeemed","already used",
        "successfully redeemed","redeemed successfully","code redeemed","try again later",
        "please try again later","too many attempts","redeem cooldown","redemption cooldown",
        "you locked your base","your base is locked","base locked","friend boost",
        "cash multi","cash multiplier","machine has been activated","has been activated",
        "discord gg","listening for codes",
        "submit after","retype invalid","duplicate guard","auto submit",
    }
    for _,phrase in ipairs(containsNoise)do
        if lower:find(phrase,1,true)then return true end
    end
    local exactNoise={
        ["vc servers"]=true,["collect"]=true,["last code"]=true,
        ["clear"]=true,["redeem"]=true,["copy"]=true,
    }
    if exactNoise[lower]then return true end
    local compact=raw:gsub("[%s,]","")
    if compact:match("^%+?%$?%d+%.?%d*[KkMmBbTtQq]$")then return true end
    if compact:match("^%+?%$%d+%.?%d*$")then return true end
    if compact:match("^%d+$")then return true end
    if raw:match("^%s*[%+%-]?%$[%d,%.]+[KkMmBbTtQq]?%s*$")then return true end
    if raw:match("^%s*%d[%d,]*%s*$")then return true end
    if lower:match("^%d+%s*seconds?$")or lower:match("^%d+%s*minutes?$")then return true end
    return false
end
local function screenTextDecision(text,path,prominent,inQuizRegion)
    local cleaned=sanitizeScreenQuestionText(text)
    local lower=normalizeQuestion(cleaned)
    path=tostring(path or""):lower()
    if cleaned== ""then return false,"EMPTY",cleaned end
    if isScreenNoiseText(cleaned)then return false,"NOISE",cleaned end
    local questionLike=cleaned:find("?",1,true)~=nil
        or lower:match("^(what|which|who|when|where|why|how|whose|is|are|was|were|do|does|did|can|could|would|should) ")~=nil
        or lower:find("backwards",1,true)~=nil
        or lower:find("in reverse",1,true)~=nil
        or lower:find("times then",1,true)~=nil
        or lower:find("times plus",1,true)~=nil
    if questionLike then
        if prominent and inQuizRegion then return true,"QUIZ",cleaned end
        return false,"QUESTION_OUTSIDE_QUIZ_REGION",cleaned
    end
    local explicitCodePath=path:find("code",1,true)or path:find("redeem",1,true)
    local explicitCodeText=lower:match("^code%s+")or lower:match("^new code%s+")
    if not explicitCodePath and not explicitCodeText then return false,"NO_CODE_CONTEXT",cleaned end
    local codeValue=cleaned:match("^[Cc][Oo][Dd][Ee]%s*[:%-]%s*([A-Za-z0-9_%-]+)%s*$")
        or cleaned:match("^[Nn][Ee][Ww]%s+[Cc][Oo][Dd][Ee]%s*[:%-]%s*([A-Za-z0-9_%-]+)%s*$")
        or cleaned
    if codeValue:find("%s")then return false,"CODE_HAS_SPACES",cleaned end
    local compactCode=codeValue:gsub("[^A-Za-z0-9]","")
    if#compactCode<5 or#compactCode>32 then return false,"CODE_LENGTH",cleaned end
    if compactCode:match("^%d+$")then return false,"SCREEN_NUMERIC",cleaned end
    local safe=GROUP_ACCESS.redeemSafetyCheck(compactCode)
    if not safe then return false,"CODE_SAFETY",cleaned end
    return true,"EXPLICIT_CODE",compactCode
end
