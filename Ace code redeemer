local function sanitizeScreenQuestionText(text)
    local cleaned=trim(aceStripRich(text or""))
    cleaned=cleaned:gsub("%s*%(%s*%d+%s*[sS]%s*%)%s*$","")
    cleaned=cleaned:gsub("%s*%[%s*%d+%s*[sS]%s*%]%s*$","")
