function UI.col3ToRich(col)
    if col==UI.COLORS.Green then return UI.CONSOLE_COLORS.Green end
    if col==UI.COLORS.Red then return UI.CONSOLE_COLORS.Red end
    if col==UI.COLORS.Text then return UI.CONSOLE_COLORS.Amber end
    if col==UI.COLORS.White then return UI.CONSOLE_COLORS.Cyan end
    if col==UI.COLORS.Dim then return UI.CONSOLE_COLORS.Dim end
    return string.format("rgb(%d,%d,%d)",math.floor(col.R*255+0.5),math.floor(col.G*255+0.5),math.floor(col.B*255+0.5))
end
function setStatus(msg,col)
    if not UI.ConsoleOutput or not STATE._enabled then return end
    if msg==STATE._lastStatusMsg then return end
    STATE._lastStatusMsg=msg
    col=col or UI.COLORS.Dim
    local line='<font color="'..UI.col3ToRich(col)..'">'..tostring(msg).."</font>"
    if UI.ConsoleOutput.Text== ""then
        UI.ConsoleOutput.Text=line
    else
        local lines={}
        for line in UI.ConsoleOutput.Text:gmatch("[^\n]+")do
            table.insert(lines,line)
        end
        if#lines>0 and(lines[1]:find("Listening for codes")or lines[1]:find("Paused"))then
            UI.ConsoleOutput.Text=lines[1].."\n\n"..line
        else
            UI.ConsoleOutput.Text=UI.ConsoleOutput.Text.."\n\n"..line
        end
    end
    UI.scrollConsoleToBottom()
end
