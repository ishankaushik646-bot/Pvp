end

KeyButton.MouseButton1Click:Connect(function()
	if State.WaitingForKey then return end
	State.WaitingForKey = true
	KeyButton.Text = "PRESS KEY..."
	KeyButton.TextColor3 = C.Purple
	Tween(KeyStroke, { Color = C.Purple }, 0.1)
