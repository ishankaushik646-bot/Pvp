local settings = {
    Low = {
        loopIterations = 28000,
        freezeTime = 0.045,
        yieldTime = 0.05,
        rubberbandChance = 0.20,
        velocityScale = 0.85,
        packetBudget = 128
    },
    Medium = {
        loopIterations = 110000,
        freezeTime = 0.10,
        yieldTime = 0.10,
