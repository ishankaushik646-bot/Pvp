local function SetSliderFromX(x)
	local absolutePosition = SliderTrack.AbsolutePosition.X
	local absoluteSize = SliderTrack.AbsoluteSize.X
	local percent = math.clamp((x - absolutePosition) / absoluteSize, 0, 1)
	local value = math.floor(percent * 200 + 0.5)
	State.CustomValue = value
	SliderFill.Size = UDim2.new(percent, 0, 1, 0)
	SliderKnob.Position = UDim2.new(percent, -9, 0.5, -9)
	SliderValue.Text = tostring(value) .. "%"
end

SliderTrack.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliderDragging = true
		SetSliderFromX(input.Position.X)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if sliderDragging then
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			SetSliderFromX(input.Position.X)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliderDragging = false
	end
end)

local function refreshPresetButtons()
	for _, data in ipairs(PresetButtons) do
		if data.Config.Label == State.SelectedPreset then
			Tween(data.Button, { BackgroundColor3 = Color3.fromRGB(34, 32, 44) }, 0.12)
			data.Button.TextColor3 = data.Config.Color
			data.Stroke.Color = data.Config.Color
			data.Stroke.Thickness = 1.7
		else
			Tween(data.Button, { BackgroundColor3 = C.DarkButton }, 0.12)
			data.Button.TextColor3 = C.GrayText
			data.Stroke.Color = C.DarkBorder
			data.Stroke.Thickness = 1
		end
	end
end

for _, data in ipairs(PresetButtons) do
	local cfg = data.Config
	local button = data.Button
	button.MouseButton1Click:Connect(function()
		State.SelectedPreset = cfg.Label
		refreshPresetButtons()
		if cfg.Label == "CUSTOM" then
			SliderFrame.Visible = true
		else
			SliderFrame.Visible = false
		end
	end)
	button.MouseEnter:Connect(function()
		if State.SelectedPreset ~= cfg.Label then
			Tween(button, { BackgroundColor3 = C.DarkButtonHover }, 0.1)
		end
	end)
	button.MouseLeave:Connect(function()
		if State.SelectedPreset ~= cfg.Label then
			Tween(button, { BackgroundColor3 = C.DarkButton }, 0.1)
		end
	end)
end

