UserInputService.InputBegan:Connect(function(input, gpe)
	if State.WaitingForKey then
		local validKeyboard = input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown
		local validGamepad = (
			input.UserInputType == Enum.UserInputType.Gamepad1
			or input.UserInputType == Enum.UserInputType.Gamepad2
			or input.UserInputType == Enum.UserInputType.Gamepad3
			or input.UserInputType == Enum.UserInputType.Gamepad4
		) and input.KeyCode ~= Enum.KeyCode.Unknown

		if validKeyboard then
			State.Keybind = input.KeyCode
			State.KeybindInputType = "Keyboard"
			State.WaitingForKey = false
			UpdateKeyLabel()
			KeyButton.TextColor3 = C.KeyText
			Tween(KeyStroke, { Color = C.KeyBorder }, 0.1)
		elseif validGamepad then
			State.Keybind = input.KeyCode
			State.KeybindInputType = "Gamepad"
			State.WaitingForKey = false
			UpdateKeyLabel()
			KeyButton.TextColor3 = C.KeyText
			Tween(KeyStroke, { Color = C.KeyBorder }, 0.1)
		end
		return
	end

	local isGamepadInput = (
		input.UserInputType == Enum.UserInputType.Gamepad1
		or input.UserInputType == Enum.UserInputType.Gamepad2
		or input.UserInputType == Enum.UserInputType.Gamepad3
		or input.UserInputType == Enum.UserInputType.Gamepad4
	)
	local isKeyboardInput = input.UserInputType == Enum.UserInputType.Keyboard

	if not gpe and (isKeyboardInput or isGamepadInput) then
		if input.KeyCode == State.Keybind then
			SetEnabled(not State.Enabled)
		end
	end
end)

