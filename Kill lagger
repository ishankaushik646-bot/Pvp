local function GetKeyName(keyCode, inputType)
	if inputType == "Gamepad" then
		return GamepadNames[keyCode] or tostring(keyCode):gsub("Enum%.KeyCode%.", "")
	else
		return tostring(keyCode):gsub("Enum%.KeyCode%.", "")
	end
end

