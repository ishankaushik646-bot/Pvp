-- DESTROY
-- ============================================================
function State.destroy()
    State.alive = false
    State.enabled = false
    StopDetection()
    stopStepConnection()
    restoreReplicationRoot()
    destroyFakeRoot()
    for _, c in ipairs(State.connections) do
        disconnect(c)
    end
    table.clear(State.connections)
    if State.gui then
        pcall(function() State.gui:Destroy() end)
        State.gui = nil
    end
    if environment[RUNTIME_KEY] == State then
        environment[RUNTIME_KEY] = nil
    end
end

