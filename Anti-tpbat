local function applyVisual(on)
    if on then
        Status.Text = "ACTIVE"
        Status.TextColor3 = Color3.fromRGB(100, 255, 140)
        Toggle.BackgroundColor3 = Color3.fromRGB(40, 120, 70)
        TweenService:Create(Knob, TweenInfo.new(0.15), {
            Position = UDim2.new(1, -18, 0, 3)
        }):Play()
    else
        Status.Text = "OFF"
        Status.TextColor3 = Color3.fromRGB(130, 130, 140)
        Toggle.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
        TweenService:Create(Knob, TweenInfo.new(0.15), {
            Position = UDim2.new(0, 3, 0, 3)
        }):Play()
    end
end

local function setEnabled(value)
    value = value == true
    if not runtime.alive then return false end
    if runtime.enabled == value then
        applyVisual(value)
        return value
    end

    runtime.enabled = value
    applyVisual(value)

    if value then
        if not enableAntiAnti() then
            runtime.enabled = false
            applyVisual(false)
            return false
        end
    else
        disableAntiAnti()
    end
    return runtime.enabled
end

local function safeToggle()
    local now = os.clock()
    if now - lastToggleAt < DEBOUNCE then return end
    lastToggleAt = now
    setEnabled(not runtime.enabled)
end

-- Dragging
local dragging, dragStart, startPos

Header.InputBegan:Connect(function(input)
    if locked then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging  = true
        dragStart = input.Position
        startPos  = Main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if locked or not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- Lock
LockBtn.MouseButton1Click:Connect(function()
    locked = not locked
    LockBtn.Text = locked and "🔒" or "🔓"
    LockBtn.BackgroundColor3 = locked
        and Color3.fromRGB(60, 20, 20)
        or  Color3.fromRGB(16, 16, 20)
end)

-- Settings panel
SettingsBtn.MouseButton1Click:Connect(function()
    settingsOpen = not settingsOpen
    local target = settingsOpen
        and UDim2.new(0, 180, 1, 0)
        or  UDim2.new(0, 0, 1, 0)
    TweenService:Create(SettingsPanel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = target
    }):Play()
end)

-- Scale
local function updateScale(newScale)
    currentScale = math.clamp(newScale, 0.5, 1.5)
    UIScale.Scale = currentScale
    ScaleValue.Text = string.format("%.2f", currentScale)
end

ScaleInc.MouseButton1Click:Connect(function()
    updateScale(currentScale + 0.05)
end)
ScaleDec.MouseButton1Click:Connect(function()
    updateScale(currentScale - 0.05)
end)

-- Toggle
ToggleHit.MouseButton1Click:Connect(safeToggle)

-- Keybind rebind
KeybindBtn.MouseButton1Click:Connect(function()
    KeybindBtn.Text = "..."
    local conn
    conn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            currentKey = input.KeyCode
            KeybindBtn.Text = input.KeyCode.Name
            conn:Disconnect()
        end
    end)
end)

-- Hotkey
trackedConnect(UserInputService.InputBegan, function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.Keyboard
        and input.KeyCode == currentKey then
        safeToggle()
    end
end)

-- ============================================================
--  CLEANUP
-- ============================================================
local function destroy()
    if not runtime.alive then return end
    runtime.alive = false
    runtime.enabled = false

    stopStepConnection()
    restoreReplicationRoot()
    destroyFakeRoot()

    for _, c in ipairs(runtime.connections) do
        disconnect(c)
    end
    table.clear(runtime.connections)

    for i = #runtime.settingsRestore, 1, -1 do
        local e = runtime.settingsRestore[i]
        pcall(function() e.instance[e.property] = e.value end)
    end
    table.clear(runtime.settingsRestore)

    pcall(function() BlindAntiTP:Destroy() end)

    if environment[RUNTIME_KEY] == runtime then
        environment[RUNTIME_KEY] = nil
    end
end
runtime.destroy = destroy
runtime.gui = BlindAntiTP

-- Final parent
parentGui(BlindAntiTP)
