-- ============================================================
-- FAKE ROOT (o "corpo fantasma" que os outros veem)
-- ============================================================
local FAKE_ROOT_NAME = "HookAntiTPBat_DesyncRoot"
local FAKE_ROOT_Y = -2500
local FAKE_ROOT_VELOCITY = Vector3.new(0, -1000, 0)

local function fakeRootIsUsable()
    local fake = State.fakeRoot
    if not isBasePart(fake) then return false end
    local ok, parent = pcall(function() return fake.Parent end)
    return ok and parent ~= nil
end

local function destroyFakeRoot()
    local fake = State.fakeRoot
    State.fakeRoot = nil
    if fake then pcall(function() fake:Destroy() end) end
end

local function createFakeRoot(basePosition)
    destroyFakeRoot()
    local fake = createInstance("Part", {
        Name = FAKE_ROOT_NAME,
        Size = Vector3.new(2, 2, 1),
        Anchored = true,
        CanCollide = false,
        CanTouch = false,
        CanQuery = false,
        Transparency = 1,
        CFrame = CFrame.new(basePosition.X, FAKE_ROOT_Y, basePosition.Z),
        AssemblyLinearVelocity = FAKE_ROOT_VELOCITY,
    }, Workspace)
    State.fakeRoot = fake
    return fake
end

-- A MÁGICA DO DESYNC:
-- Diz pro servidor que a "raiz de replicação de física" do seu HumanoidRootPart
-- é o fake root. Assim, o servidor replica sua posição a partir do fake,
-- mas localmente você continua se vendo / se movendo no seu root real.
local function assignFakeReplicationRoot(rootPart, fake)
    if not isBasePart(rootPart) or not isBasePart(fake) then return false end
    State.repRootOwner = rootPart
    return setHidden(rootPart, "PhysicsRepRootPart", fake)
end

local function restoreReplicationRoot()
    local root = State.rootPart or getCurrentRoot()
    if isBasePart(root) then
        setHidden(root, "PhysicsRepRootPart", root)
    end
    if isBasePart(State.repRootOwner) and State.repRootOwner ~= root then
        setHidden(State.repRootOwner, "PhysicsRepRootPart", State.repRootOwner)
    end
    State.repRootOwner = nil
end

-- ============================================================
-- APLICAR MODO (V1 / V2 / V3)
-- ============================================================
local function moveFakeTo(cf)
    local fake = State.fakeRoot
    if not isBasePart(fake) then return end
    pcall(function() fake.CFrame = cf end)
    pcall(function() fake.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
    pcall(function() fake.AssemblyAngularVelocity = Vector3.new(0, 0, 0) end)
end

local function applyModeToFake()
    local fake = State.fakeRoot
    if not isBasePart(fake) then return end
    local base = State.originalCFrame
    if not base then return end

    local mode = State.mode
    local targetCFrame

    if mode == "V1" then
        -- desync lateral (ocean)
        targetCFrame = CFrame.new(base.Position.X + 500, base.Position.Y - 200, base.Position.Z + 500)
    elseif mode == "V2" then
        -- void -999
        targetCFrame = CFrame.new(base.Position.X, -999, base.Position.Z)
    elseif mode == "V3" then
        -- tp 9999999999999 pra cima
        targetCFrame = CFrame.new(base.Position.X, 9999999999999, base.Position.Z)
    end

    if targetCFrame then
        moveFakeTo(targetCFrame)
    end
end

-- ============================================================
-- STEP DESYNC (mantém o PhysicsRepRootPart setado)
-- ============================================================
local function stepDesync()
    if not State.alive or not State.enabled then return end
    local root = State.rootPart
    if not isBasePart(root) then
        root = getCurrentRoot(State.character)
        State.rootPart = root
    end
    if not root then return end

    if not fakeRootIsUsable() then
        local fake = createFakeRoot(root.Position)
        assignFakeReplicationRoot(root, fake)
        applyModeToFake()
        return
    end

    local fake = State.fakeRoot
    pcall(function()
        fake.Anchored = true
        fake.AssemblyLinearVelocity = FAKE_ROOT_VELOCITY
    end)

    -- garante que o servidor continua replicando a partir do fake
    local gotValue, current = getHidden(root, "PhysicsRepRootPart")
    if not gotValue or current ~= fake then
        setHidden(root, "PhysicsRepRootPart", fake)
    end
end

local function stopStepConnection()
    disconnect(State.stepConnection)
    State.stepConnection = nil
end

local function startStepConnection()
    stopStepConnection()
    State.stepConnection = RunService.Stepped:Connect(stepDesync)
end

