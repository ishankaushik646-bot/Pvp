-- DETECÇÃO
-- ============================================================
local trackers = {}

local function GetRoot(plr)
    local c = plr and plr.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function CheckTeleport(plr, root)
    local now = tick()
    local prev = trackers[plr]
    if not prev then
        trackers[plr] = { lastPos = root.Position, lastTime = now }
        return false
    end
    local dt = now - prev.lastTime
    if dt < 0.005 then return false end
    local delta = (root.Position - prev.lastPos).Magnitude
    local speed = delta / dt
    prev.lastPos = root.Position
    prev.lastTime = now
    if speed > State.config.VelocityThreshold or delta > State.config.DeltaThreshold then
        return true, speed, delta
    end
    return false
end

local function HasTool(plr)
    local c = plr and plr.Character
    if not c then return false end
    return c:FindFirstChildOfClass("Tool") ~= nil
end

-- ============================================================
-- ANCHOR SELF (anti-die godmode)
-- ============================================================
local function AnchorSelf()
    if not State.config.AnchorEnabled then return end
    if State.isAnchored then return end
    State.isAnchored = true

    local char = LP.Character
    if not char then State.isAnchored = false return end

    State.lastAnchorParts = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            table.insert(State.lastAnchorParts, { part = part, anchored = part.Anchored })
            part.Anchored = true
        end
    end
    task.delay(State.config.AnchorTime, function()
        for _, entry in ipairs(State.lastAnchorParts) do
            if entry.part and entry.part.Parent then
                entry.part.Anchored = entry.anchored
            end
        end
        State.lastAnchorParts = {}
        State.isAnchored = false
    end)
end

-- ============================================================
-- PUSH (anti-die)
-- ============================================================
local function PushAttacker(attacker, myRoot)
    if not State.config.PushEnabled then return end
    local atkRoot = GetRoot(attacker)
    if not atkRoot then return end

    local dir = atkRoot.Position - myRoot.Position
    if dir.Magnitude < 0.1 then
        dir = Vector3.new(math.random(-1, 1), 0, math.random(-1, 1))
    end
    dir = dir.Unit
    if dir.Y ~= dir.Y then dir = Vector3.new(1, 0, 0) end

    pcall(function() atkRoot:SetNetworkOwner(LP) end)

    local force = dir * State.config.PushPower + Vector3.new(0, 100, 0)
    pcall(function() atkRoot.AssemblyLinearVelocity = force end)

    pcall(function()
        local old = atkRoot:FindFirstChild("HookAntiTPBat_Push")
        if old then old:Destroy() end
        local oldAtt = atkRoot:FindFirstChild("HookAntiTPBat_Att")
        if oldAtt then oldAtt:Destroy() end

        local att = Instance.new("Attachment")
        att.Name = "HookAntiTPBat_Att"
        att.Parent = atkRoot

        local lv = Instance.new("LinearVelocity")
        lv.Name = "HookAntiTPBat_Push"
        lv.Attachment0 = att
        lv.MaxForce = math.huge
        lv.VectorVelocity = force
        lv.RelativeTo = Enum.ActuatorRelativeTo.World
        lv.Parent = atkRoot

        task.delay(0.25, function()
            if lv and lv.Parent then lv:Destroy() end
            if att and att.Parent then att:Destroy() end
        end)
    end)
end

-- ============================================================
-- ACTIVATE
-- ============================================================
local function Activate(attacker)
    local now = tick()
    if now - State.config.LastTrigger < State.config.Cooldown then return end
    State.config.LastTrigger = now

    local myRoot = GetRoot(LP)
    if not myRoot then return end

    if attacker then PushAttacker(attacker, myRoot) end
    AnchorSelf()
end

-- ============================================================
-- DETECTION LOOP
-- ============================================================
local function StartDetection()
    if State.detectionConnection then State.detectionConnection:Disconnect() end
    State.detectionConnection = RunService.Heartbeat:Connect(function()
        if not State.enabled then return end
        if State.isAnchored then return end
        local myRoot = GetRoot(LP)
        if not myRoot then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                local root = GetRoot(plr)
                if root then
                    local dist = (root.Position - myRoot.Position).Magnitude
                    if dist <= State.config.Radius then
                        if CheckTeleport(plr, root) then
                            Activate(plr)
                            return
                        end
                        if dist < 6 and HasTool(plr) then
                            Activate(plr)
                            return
                        end
                    else
                        CheckTeleport(plr, root)
                    end
                end
            end
        end
    end)
end

local function StopDetection()
    if State.detectionConnection then
        State.detectionConnection:Disconnect()
        State.detectionConnection = nil
    end
end

-- ============================================================
-- BIND CHARACTER
-- ============================================================
local function bindCharacter(character)
    local oldRoot = State.rootPart
    State.character = character
    State.rootPart = getCurrentRoot(character)

    if State.enabled then
        if isBasePart(oldRoot) and oldRoot ~= State.rootPart then
            setHidden(oldRoot, "PhysicsRepRootPart", oldRoot)
        end
        destroyFakeRoot()

        local root = State.rootPart
        if not root and character then
            local ok, waitedRoot = pcall(function()
                return character:WaitForChild("HumanoidRootPart", 8)
            end)
            if ok and isBasePart(waitedRoot) then
                root = waitedRoot
                State.rootPart = root
            end
        end

        if root then
            State.originalCFrame = root.CFrame
            local fake = createFakeRoot(root.Position)
            assignFakeReplicationRoot(root, fake)
            startStepConnection()
            applyModeToFake()
        end
    end
end

bindCharacter(LP.Character)
connect(LP.CharacterAdded, function(character)
    task.defer(bindCharacter, character)
end)

-- ============================================================
-- ENABLE / DISABLE
-- ============================================================
local function setEnabled(value)
    if not State.alive then return false end
    value = value == true
    if State.enabled == value then return value end

    if value then
        local root = getCurrentRoot(State.character or LP.Character)
        if not root then return false end
        State.rootPart = root
        State.character = LP.Character
        -- GUARDA A POSIÇÃO ONDE VOCÊ ATIVOU (é aqui que VOCÊ vai ficar)
        State.originalCFrame = root.CFrame
        State.enabled = true

        -- Cria o fake root (é aqui que OS OUTROS vão te ver)
        local fake = createFakeRoot(root.Position)
        assignFakeReplicationRoot(root, fake)
        startStepConnection()
        StartDetection()
        applyModeToFake()
        -- NÃO MEXE NA CÂMERA! Você continua vendo a si mesmo no lugar original.
    else
        State.enabled = false

        StopDetection()
        stopStepConnection()
        restoreReplicationRoot()
        destroyFakeRoot()

        local root = State.rootPart or getCurrentRoot(State.character)
        if isBasePart(root) then
            pcall(function() root:SetNetworkOwner(LP) end)
        end

        State.originalCFrame = nil
    end
    return State.enabled
end

local function toggleEnabled()
    return setEnabled(not State.enabled)
end

