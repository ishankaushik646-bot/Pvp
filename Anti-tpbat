local function applyModeUI()
    State.mode = MODE_ORDER[modeIndex]
    ModeBtn.Text = State.mode

    if State.enabled then
        if not fakeRootIsUsable() then
            local root = getCurrentRoot(State.character)
            if root then
                State.originalCFrame = State.originalCFrame or root.CFrame
                local fake = createFakeRoot(root.Position)
                assignFakeReplicationRoot(root, fake)
                startStepConnection()
            end
        end
        applyModeToFake()
    end
end

