local function parentGui(gui)
    local function try(target)
        pcall(function() gui.Parent = target end)
        return gui.Parent ~= nil
    end
    if try(pg) then return true end
    pcall(function()
        if typeof(gethui) == "function" then
            local h = gethui()
            if h and try(h) then return true end
        end
    end)
    if try(game:GetService("CoreGui")) then return true end
    return false
end

