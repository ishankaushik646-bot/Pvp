-- BODY LOCK (from Envy)
-- ============================================================
local bodyLockConnection = nil
local bodyLockUpdateTargetConnection = nil
local bodyLockTarget = nil

local function getClosestPlayerForBodyLock()
    local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local myPos = myHRP.Position
    local closestDist = math.huge
    local closest = nil
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                if char.Humanoid.Health > 0 then
                    local pos = char.HumanoidRootPart.Position
                    local dist = (myPos - pos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = plr
                    end
                end
            end
        end
    end
    return closest
end

local function bodyLockLoop()
    if not State.bodyLockEnabled then return end
    local target = bodyLockTarget
    if not target then
        target = getClosestPlayerForBodyLock()
        if target then bodyLockTarget = target end
    end
    if not target then return end
    local targetChar = target.Character
    if not targetChar then bodyLockTarget = nil; return end
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if targetHRP and myHRP and hum then
        local myPos = myHRP.Position
        local targetPos = targetHRP.Position
        local direction = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z)
        if direction.Magnitude > 0.5 then
            local angle = math.atan2(direction.X, direction.Z)
            angle = angle + math.pi
            myHRP.CFrame = CFrame.new(myPos) * CFrame.Angles(0, angle, 0)
            hum.AutoRotate = false
        end
    else
        bodyLockTarget = nil
    end
end

local function updateBodyLockTarget()
    if State.bodyLockEnabled then bodyLockTarget = getClosestPlayerForBodyLock() end
end

local startBodyLock, stopBodyLock
startBodyLock = function()
    if bodyLockConnection then return end
    bodyLockConnection = RunService.Heartbeat:Connect(bodyLockLoop)
    if bodyLockUpdateTargetConnection then bodyLockUpdateTargetConnection:Disconnect() end
    bodyLockUpdateTargetConnection = RunService.Heartbeat:Connect(function()
        if tick() % 1 < 0.02 then updateBodyLockTarget() end
    end)
    bodyLockTarget = getClosestPlayerForBodyLock()
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = false end
    print("[Duels] Body Lock ON")
end

stopBodyLock = function()
    if bodyLockConnection then bodyLockConnection:Disconnect(); bodyLockConnection = nil end
    if bodyLockUpdateTargetConnection then bodyLockUpdateTargetConnection:Disconnect(); bodyLockUpdateTargetConnection = nil end
    bodyLockTarget = nil
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = true end
    print("[Duels] Body Lock OFF")
end

local function toggleBodyLock()
    State.bodyLockEnabled = not State.bodyLockEnabled
    if State.bodyLockEnabled then startBodyLock() else stopBodyLock() end
    if toggleSetters["bodyLock"] then pcall(toggleSetters["bodyLock"], State.bodyLockEnabled) end
    if requestSave then requestSave() end
end



