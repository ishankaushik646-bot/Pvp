    end
end

function M.stopAutoSteal()
    if M.statusGui then M.statusGui.Enabled = true end
    M.stopNormalSteal()
    M.stopSemiSteal()
    M.stopV3Steal()
    M.isStealing = false
    M.updateStealProgress(0)
end

