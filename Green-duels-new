-- ====================== UI LOGIC ======================
local function updateModeUI()
    local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    if carry then
        TweenService:Create(modeToggle, tweenInfo, {BackgroundColor3 = Color3.fromRGB(120, 80, 255)}):Play()
        TweenService:Create(modeKnob, tweenInfo, {Position = UDim2.new(1, -21, 0.5, -9)}):Play()
        speedMode.Text = "CARRY"
        speedMode.TextColor3 = Color3.fromRGB(180, 140, 255)
    else
        TweenService:Create(modeToggle, tweenInfo, {BackgroundColor3 = Color3.fromRGB(40, 40, 55)}):Play()
        TweenService:Create(modeKnob, tweenInfo, {Position = UDim2.new(0, 3, 0.5, -9)}):Play()
        speedMode.Text = "NORMAL"
        speedMode.TextColor3 = Color3.fromRGB(140, 140, 160)
    end
end

local function toggleCarry()
    carry = not carry
    updateModeUI()
end

modeToggle.MouseButton1Click:Connect(toggleCarry)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.C then
