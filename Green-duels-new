function _G.AmbitiousStartNormalAimbot(keepV2)
  -- Anti Die SUBITO, prima riga della funzione. Stava nel wrapper in fondo
  -- al file: funzionava solo per chi chiamava il nome globale DOPO che i
  -- wrapper erano stati installati, e chi entrava per altre strade (o
  -- prima) partiva scoperto. Qui non c'e' strada che lo salti.
  if _G.AmbitiousAntiDieArmNow then pcall(_G.AmbitiousAntiDieArmNow) end
  if _G.AmbitiousSafeModeTryStart and not _G.AmbitiousSafeModeTryStart() then return false end
  if _G.AmbitiousStopAutoTPForAction then _G.AmbitiousStopAutoTPForAction() end
  -- keepV2 = true quando e' il Bat Aimbot V2 a usare questo chase come fase 1
  if not keepV2 then
    if _G.AmbitiousStopBatAimbotV2 then _G.AmbitiousStopBatAimbotV2(false) end
    _G.AmbitiousBatAimbotV2On = false
  end
  _G.AmbitiousNormalAimbotOn = true
  if _G.AmbitiousStartChaseRagdollWatcher then _G.AmbitiousStartChaseRagdollWatcher() end
  if _G.AmbitiousNormalAimbot.conn then
    _G.AmbitiousNormalAimbot.conn:Disconnect()
    _G.AmbitiousNormalAimbot.conn = nil
  end
  local hum0 = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
  if hum0 then hum0.AutoRotate = false end
  _G.AmbitiousNormalAimbot.conn = RunService.RenderStepped:Connect(function()
    if not _G.AmbitiousNormalAimbotOn then return end
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local bat = char:FindFirstChildOfClass("Tool") or _G.AmbitiousFindAimbotBat()
    if bat and bat.Parent ~= char then
      pcall(function() hum:EquipTool(bat) end)
    end
    local target = _G.AmbitiousGetClosestAimbotTarget()
    if not target then return end
    _G.AmbitiousNormalAimbot.target = target

    -- >>> AIMBOT CHASE MODE BEGIN
    -- Se l'aimbot attivo e' in BYPASS si usa l'inseguimento alternativo.
    local _chaseKey  = (_G.AmbitiousBatAimbotV2On == true) and "V2" or "V1"
    local _chaseMode = (_G._AmbitiousAimbotChase and _G._AmbitiousAimbotChase[_chaseKey]) or "NORMAL"
    if _chaseMode == "BYPASS" then
      local myPos     = root.Position
      local targetPos = target.Position
      -- >>> ANTI VOID BEGIN
      if _G.AmbitiousAntiVoid then
        targetPos = _G.AmbitiousAntiVoid.posForPart(target, targetPos)
      end
      -- <<< ANTI VOID END
      local direction = targetPos - myPos
      local flatDir   = Vector3.new(direction.X, 0, direction.Z)
      if flatDir.Magnitude > 0 then flatDir = flatDir.Unit else flatDir = Vector3.zero end
      -- >>> PATHFINDING <<< percorso vero verso il bersaglio, come Auto
      -- Left/Right ma DINAMICO: il nemico si muove, quindi il percorso si
      -- ricalcola spesso (0.35s) e subito se si e' spostato di 4 studs.
      if _G.AmbitiousPathfind and flatDir.Magnitude > 0 then
        local pd = _G.AmbitiousPathfind.dirTo("aimbot", myPos, targetPos,
                     {recompute = 0.35, drift = 4})
        if pd then flatDir = pd end
      end

      local chaseSpeed = (_G.AmbitiousBatAimbotV2On == true)
        and (_G.AmbitiousGetBatAimbotV2Speed and _G.AmbitiousGetBatAimbotV2Speed() or _G.AmbitiousGetNormalAimbotSpeed())
        or _G.AmbitiousGetNormalAimbotSpeed()

      -- >>> BAT AIMBOT V2: inseguimento alla stessa altezza del nemico <<<
      -- Il V1 sale di 3.7 stud e si stacca da terra; il V2 no, va dritto
      -- addosso al player restando al suo livello.
      local _isV2 = (_G.AmbitiousBatAimbotV2On == true)
      local desiredHeight = targetPos.Y + (_isV2 and 0 or 3.7)
      local yVel = (desiredHeight - myPos.Y) * 19.5
      if not _isV2 and hum.FloorMaterial ~= Enum.Material.Air then yVel = math.max(yVel, 13) end
      yVel = math.clamp(yVel, -70, 110)

      local desiredVel = Vector3.new(flatDir.X * chaseSpeed, yVel, flatDir.Z * chaseSpeed)
      root.AssemblyLinearVelocity = root.AssemblyLinearVelocity:Lerp(desiredVel, 0.8)

      local toTarget = targetPos - myPos
      if toTarget.Magnitude > 0.1 then
        local goalCF = CFrame.lookAt(myPos, targetPos)
        local diffCF = root.CFrame:Inverse() * goalCF
        local rx, ry, rz = diffCF:ToEulerAnglesXYZ()
        rx = math.clamp(rx, -2.5, 2.5)
        ry = math.clamp(ry, -2.5, 2.5)
        rz = math.clamp(rz, -2.5, 2.5)
        root.AssemblyAngularVelocity = root.CFrame:VectorToWorldSpace(Vector3.new(rx * 42, ry * 42, rz * 42))
      end

      -- Col V2 lo swing appartiene al TP Bat, non al chase.
      -- Niente soglia di distanza: qui c'era un "toTarget.Magnitude <= 8"
      -- che il ramo Normal non ha, ed e' il motivo per cui in Bypass il
      -- V1 iniziava a menare solo una volta arrivato addosso al nemico
      -- invece che dall'accensione.
      if autoSwingEnabled and bat and _G.AmbitiousBatAimbotV2On ~= true
        and not _G.AmbitiousNormalAimbot.swingCooldown then
        _G.AmbitiousNormalAimbot.swingCooldown = true
        pcall(function() bat:Activate() end)
        task.delay(0.08, function()
          if _G.AmbitiousNormalAimbot then _G.AmbitiousNormalAimbot.swingCooldown = false end
        end)
      end
      return
    end
    -- <<< AIMBOT CHASE MODE END

    local targetVel = target.AssemblyLinearVelocity
    local myPos = root.Position
    local targetPos = target.Position
    -- >>> ANTI VOID BEGIN
    if _G.AmbitiousAntiVoid then
      local gp, isGhost = _G.AmbitiousAntiVoid.posForPart(target, targetPos)
      targetPos = gp
      -- fuori zona non c'e' niente da predire: il bersaglio e' fermo
      if isGhost then targetVel = Vector3.zero end
    end
    -- <<< ANTI VOID END
    -- >>> BAT AIMBOT V2: nessuna predizione <<<
    -- Il V1 anticipa il bersaglio (velocita' * 0.14 + un pezzo di LookVector);
    -- il V2 punta la posizione reale, senza anticipo.
    local _isV2 = (_G.AmbitiousBatAimbotV2On == true)
    local predictPos = targetPos
    if not _isV2 then
      predictPos = targetPos + targetVel * 0.14 + target.CFrame.LookVector * 0.3
    end
    local direction = predictPos - myPos
    if direction.Magnitude < 0.01 then return end
    local flatDir = Vector3.new(direction.X, 0, direction.Z)
    if flatDir.Magnitude < 0.01 then return end
    flatDir = flatDir.Unit
    -- >>> PATHFINDING <<< come nel ramo Bypass. La mira resta sul
    -- bersaglio, non sulla direzione del waypoint.
    if _G.AmbitiousPathfind then
      local pd = _G.AmbitiousPathfind.dirTo("aimbot", myPos, targetPos,
                   {recompute = 0.35, drift = 4})
      if pd then flatDir = pd end
    end
    local chaseSpeed = (_G.AmbitiousBatAimbotV2On == true)
      and (_G.AmbitiousGetBatAimbotV2Speed and _G.AmbitiousGetBatAimbotV2Speed() or _G.AmbitiousGetNormalAimbotSpeed())
      or _G.AmbitiousGetNormalAimbotSpeed()
    -- >>> BAT AIMBOT V2: inseguimento alla stessa altezza del nemico <<<
    -- Il V1 sale di 3.7 stud e si stacca da terra; il V2 no, va dritto
    -- addosso al player restando al suo livello.
    local desiredHeight = targetPos.Y + (_isV2 and 0 or 3.7)
    local yVel = (desiredHeight - myPos.Y) * 19.5
    if not _isV2 then
      -- anticipo verticale: solo V1
      yVel = yVel + targetVel.Y * 0.8
    end
    if not _isV2 and hum.FloorMaterial ~= Enum.Material.Air then
      yVel = math.max(yVel, 13)
    end
    yVel = math.clamp(yVel, -70, 110)
    local desiredVel = Vector3.new(flatDir.X * chaseSpeed, yVel, flatDir.Z * chaseSpeed)
    root.AssemblyLinearVelocity = root.AssemblyLinearVelocity:Lerp(desiredVel, 0.8)
    -- Mira: il V1 anticipa in base alla velocita', il V2 guarda il punto reale.
    local predictedPos = targetPos
    if not _isV2 then
      local predictTime = math.clamp(targetVel.Magnitude / 150, 0.05, 0.2)
      predictedPos = targetPos + targetVel * predictTime
    end
    local toPredict = predictedPos - myPos
    if toPredict.Magnitude > 0.1 then
      local goalCF = CFrame.lookAt(myPos, predictedPos)
      local diffCF = root.CFrame:Inverse() * goalCF
      local rx, ry, rz = diffCF:ToEulerAnglesXYZ()
      rx = math.clamp(rx, -2.5, 2.5)
      ry = math.clamp(ry, -2.5, 2.5)
      rz = math.clamp(rz, -2.5, 2.5)
      root.AssemblyAngularVelocity = root.CFrame:VectorToWorldSpace(Vector3.new(rx * 42, ry * 42, rz * 42))
    end
    -- Col V2 lo swing appartiene al TP Bat, non al chase
    if autoSwingEnabled and bat and _G.AmbitiousBatAimbotV2On ~= true
      and not _G.AmbitiousNormalAimbot.swingCooldown then
      _G.AmbitiousNormalAimbot.swingCooldown = true
      pcall(function() bat:Activate() end)
      task.delay(0.08, function()
        if _G.AmbitiousNormalAimbot then _G.AmbitiousNormalAimbot.swingCooldown = false end
      end)
    end
  end)
  if _G.AmbitiousRefreshAimbotVisual then _G.AmbitiousRefreshAimbotVisual() end
  if _G.AmbitiousRefreshMobileButtonStates then _G.AmbitiousRefreshMobileButtonStates() end
end

function _G.AmbitiousStopNormalAimbot()
  _G.AmbitiousNormalAimbotOn = false
  if _G.AmbitiousStopChaseRagdollWatcher then _G.AmbitiousStopChaseRagdollWatcher() end
  -- Percorso buttato: al prossimo inseguimento si riparte da dove sei
  -- adesso, non da waypoint calcolati per un bersaglio vecchio.
  if _G.AmbitiousPathfind then pcall(_G.AmbitiousPathfind.reset, "aimbot") end
  if _G.AmbitiousNormalAimbot and _G.AmbitiousNormalAimbot.conn then
    _G.AmbitiousNormalAimbot.conn:Disconnect()
    _G.AmbitiousNormalAimbot.conn = nil
  end
  if _G.AmbitiousNormalAimbot then
    _G.AmbitiousNormalAimbot.target = nil
    _G.AmbitiousNormalAimbot.swingCooldown = false
  end
  local c = LP.Character
  local root = c and c:FindFirstChild("HumanoidRootPart")
  if root then
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
  end
  local hum2 = c and c:FindFirstChildOfClass("Humanoid")
  if hum2 then hum2.AutoRotate = true end
  if _G.AmbitiousRefreshAimbotVisual then _G.AmbitiousRefreshAimbotVisual() end
  if _G.AmbitiousRefreshMobileButtonStates then _G.AmbitiousRefreshMobileButtonStates() end
end

-- ===== BAT AIMBOT V2 =====
-- Il V2 non ha piu' una logica di inseguimento propria: riusa il chase del
-- Bat Aimbot V1 (con le sue velocita' dedicate) e, appena arriva entro
-- BAT_AIMBOT_V2_TP_DISTANCE stud dal nemico, passa il controllo al TP Bat.
-- In questa fase il TP Bat ignora la sua distanza minima di 8 stud: lo snap
-- avviene comunque. Il TP Bat avviato a mano continua invece a rispettarla.
_G.AmbitiousBatAimbotV2State = _G.AmbitiousBatAimbotV2State or {conn = nil}
_G.AmbitiousBatAimbotV2TPDistance = 4

function _G.AmbitiousBatAimbotV2GetClosest()
  local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
  if not root then return nil, math.huge end
  local closest, minDist = nil, math.huge
  for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= LP and plr.Character then
      local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
      local hum = plr.Character:FindFirstChildOfClass("Humanoid")
      if tRoot and hum and hum.Health > 0 then
        -- >>> ANTI VOID BEGIN
        -- Nel void la distanza va misurata sulla posizione fantasma,
        -- altrimenti il bersaglio risulta lontanissimo e il trigger
        -- dei 4 stud del V2 non scatta mai.
        local tPos = tRoot.Position
        if _G.AmbitiousAntiVoid then
          tPos = _G.AmbitiousAntiVoid.posFor(plr, tPos)
        end
        local dist = (tPos - root.Position).Magnitude
        -- <<< ANTI VOID END
        if dist < minDist then
          minDist = dist
          closest = tRoot
        end
      end
    end
  end
  return closest, minDist
end

