    function _G.DuelsPathfind.rayParams()
        local params = RaycastParams.new()
        local ignore = {}
        local ch = LP.Character
        if ch then ignore[#ignore+1]=ch end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr~=LP and plr.Character then ignore[#ignore+1]=plr.Character end
        end
        params.FilterDescendantsInstances=ignore
        params.FilterType=Enum.RaycastFilterType.Exclude
        params.IgnoreWater=true
        return params
    end
    function _G.DuelsPathfind.blocked(o,d,dist,p)
        local r=workspace:Raycast(o,d*dist,p)
        if not r then return false end
        if math.abs(r.Normal.Y)>0.6 then return false end
        return true
    end
    function _G.DuelsPathfind.avoid(o,d,dist)
        local p=_G.DuelsPathfind.rayParams()
        if not _G.DuelsPathfind.blocked(o,d,dist,p) then return d end
        for _,a in ipairs(_G.DuelsPathfind.cfg.ANGLES) do
            for _,s in ipairs({1,-1}) do
                local rad=math.rad(a*s)
                local rot=Vector3.new(d.X*math.cos(rad)-d.Z*math.sin(rad),0,d.X*math.sin(rad)+d.Z*math.cos(rad))
                if rot.Magnitude>0 then rot=rot.Unit end
                if not _G.DuelsPathfind.blocked(o,rot,dist,p) then return rot end
            end
        end
        return d
    end
