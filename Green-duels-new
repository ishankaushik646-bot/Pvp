    local function applyImpulseForVelocity(hrp, desiredVelocity)
    if not hrp or not desiredVelocity then return end
    local flat = Vector3.new(desiredVelocity.X, 0, desiredVelocity.Z)
    local spd = flat.Magnitude
    if spd < 0.05 then
        hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
        hrp.AssemblyAngularVelocity = Vector3.zero
        return
    end
    local dir = flat.Unit
    pcall(function()
        if hrp.SetNetworkOwner then hrp:SetNetworkOwner(LP) end
    end)
    hrp.AssemblyLinearVelocity = Vector3.new(dir.X * spd, hrp.AssemblyLinearVelocity.Y, dir.Z * spd)
end

