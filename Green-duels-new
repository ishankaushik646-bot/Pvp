                    M._activeKBBtn=nil; M._anyKeyListening=false; saveOrvynConfig()
                end
                return
            end
            if gameProcessed then return end
            if input.UserInputType~=Enum.UserInputType.Keyboard then return end
            local kc=input.KeyCode
            local function kbMatch(entry, keycode) if not entry then return false end; if entry.kb and entry.kb==keycode then return true end; if entry.gp and entry.gp==keycode then return true end; return false end
