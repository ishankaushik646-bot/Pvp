        local lbl=Instance.new("TextLabel", row); lbl.Size=UDim2.new(1,-70,1,0); lbl.Position=UDim2.new(0,14,0,0); lbl.BackgroundTransparency=1; lbl.Text=label; lbl.TextColor3=Color3.fromRGB(225,240,230); lbl.Font=Enum.Font.GothamBold; lbl.TextSize=12; lbl.TextXAlignment=Enum.TextXAlignment.Left
        local pill=Instance.new("Frame", row); pill.Size=UDim2.new(0,44,0,22); pill.Position=UDim2.new(1,-58,0.5,-11); pill.BackgroundColor3=def and Color3.fromRGB(0,210,210) or Color3.fromRGB(30,36,32); mkCorner(pill,11)
