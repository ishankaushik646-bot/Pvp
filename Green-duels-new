            if M._anyKeyListening and M._activeKBBtn then
                local kc=input.KeyCode
                if kc==Enum.KeyCode.Escape then M._activeKBBtn.Text="..."; M._activeKBBtn=nil; M._anyKeyListening=false; saveOrvynConfig(); return end
