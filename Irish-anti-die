local function addCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = parent
end

local function addStroke(parent, color, transparency, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Color3.fromRGB(48, 55, 68)
    stroke.Transparency = transparency or 0.3
    stroke.Thickness = thickness or 1
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
end

local function applyViewportScale(scaleObj)
    local function updateScale()
        scaleObj.Scale = Configuration.UIScaleValue
    end
    updateScale()
    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(updateScale)
end

local function makeDraggable(frame, dragHandle)
    local handle = dragHandle or frame
    local dragging, dragStart, startPosition
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
        end
    end)
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local function buildToggleRow(parent, labelText, yOffset)
    local row = Instance.new("Frame")
    row.Size = Configuration.Size[labelText == "Anti Die" and "AntiDieRow" or "AntiFlingRow"]
    row.Position = yOffset
    row.BackgroundColor3 = Configuration.Colors.RowBG
    row.BorderSizePixel = 0
    row.Parent = parent
    addCorner(row, 14)
    addStroke(row, Configuration.Colors.RowStroke, 0.35, 1)
    local lbl = Instance.new("TextLabel")
    lbl.Text = labelText
    lbl.TextColor3 = Configuration.Colors.TitleText
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -120, 1, 0)
    lbl.Position = Configuration.Position.LabelInRow
    lbl.Parent = row
    local toggleBG = Instance.new("Frame")
    toggleBG.Size = Configuration.Size.ToggleBG
    toggleBG.Position = Configuration.Position.ToggleBG
    toggleBG.BackgroundColor3 = Configuration.Colors.ToggleOffBG
    toggleBG.BorderSizePixel = 0
    toggleBG.Parent = row
    addCorner(toggleBG, 15)
    local knob = Instance.new("Frame")
    knob.Size = Configuration.Size.ToggleKnob
    knob.Position = Configuration.Position.ToggleKnob
    knob.BackgroundColor3 = Configuration.Colors.ToggleOffKnob
    knob.BorderSizePixel = 0
    knob.Parent = toggleBG
    addCorner(knob, 12)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = row
    return row, toggleBG, knob, btn
end

local function getHumanoid()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
end

local function applyAntiDie(humanoid)
    if not humanoid then return end
    humanoid.MaxHealth = math.huge
    humanoid.Health = math.huge
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    table.insert(AntiDieConnections, humanoid:GetPropertyChangedSignal("Health"):Connect(function()
        if Configuration.ToggleStates.AntiDie then humanoid.Health = humanoid.MaxHealth end
    end))
    table.insert(AntiDieConnections, humanoid.StateChanged:Connect(function(_, state)
        if state == Enum.HumanoidStateType.Dead and Configuration.ToggleStates.AntiDie then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            humanoid.Health = humanoid.MaxHealth
        end
    end))
end

local function setAntiDie(state)
    Configuration.ToggleStates.AntiDie = state
    AntiDieKnob.BackgroundColor3 = state and Configuration.Colors.ToggleOnKnob or Configuration.Colors.ToggleOffKnob
    AntiDieToggleBG.BackgroundColor3 = state and Configuration.Colors.ToggleOnBG or Configuration.Colors.ToggleOffBG
    for _, conn in ipairs(AntiDieConnections) do conn:Disconnect() end
    AntiDieConnections = {}
    if state then
        local char = LocalPlayer.Character
        if char then
            local hl = Instance.new("Highlight")
            hl.Name = Configuration.Names.HighlightTag
            hl.FillColor = Configuration.Colors.HighlightFill
            hl.OutlineColor = Configuration.Colors.HighlightOutline
            hl.FillTransparency = 0.75
            hl.Parent = char
            applyAntiDie(getHumanoid())
        end
        table.insert(AntiDieConnections, LocalPlayer.CharacterAdded:Connect(function(newChar)
            task.wait(0.2)
            if Configuration.ToggleStates.AntiDie then
                local hl = Instance.new("Highlight")
                hl.Name = Configuration.Names.HighlightTag
                hl.Parent = newChar
                applyAntiDie(newChar:FindFirstChildOfClass("Humanoid"))
            end
        end))
    else
        if LocalPlayer.Character then
            local hl = LocalPlayer.Character:FindFirstChild(Configuration.Names.HighlightTag)
            if hl then hl:Destroy() end
            local hum = getHumanoid()
            if hum then hum.MaxHealth = 100 hum.Health = 100 end
        end
    end
end

local function claimOwnership(char)
    if char and char:FindFirstChild("HumanoidRootPart") then
        pcall(function() char.HumanoidRootPart:SetNetworkOwner(LocalPlayer) end)
    end
end

local function setAntiFling(state)
    Configuration.ToggleStates.AntiFling = state
    AntiFlingKnob.BackgroundColor3 = state and Configuration.Colors.ToggleOnKnob or Configuration.Colors.ToggleOffKnob
    AntiFlingToggleBG.BackgroundColor3 = state and Configuration.Colors.ToggleOnBG or Configuration.Colors.ToggleOffBG
    for _, conn in ipairs(AntiFlingConnections) do conn:Disconnect() end
    AntiFlingConnections = {}
    if state then
        table.insert(AntiFlingConnections, RunService.RenderStepped:Connect(function()
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character then claimOwnership(player.Character) end
            end
        end))
    end
end

local function toggleMinimize()
    isMinimized = not isMinimized
    MinimizeButton.Text = isMinimized and "+" or "−"
    local targetSize = isMinimized and Configuration.Size.MainCollapsed or Configuration.Size.Main
    TweenService:Create(MainFrame, TweenInfo.new(Configuration.MinimizeTweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = targetSize}):Play()
end

