local function spawnDiscordTag(char)
    local head = char and char:FindFirstChild("Head")
    if not head then return end
    local old = head:FindFirstChild("K7DiscordBB")
    if old then old:Destroy() end

    local bb = Instance.new("BillboardGui", head)
    bb.Name = "K7DiscordBB"
    bb.Size = UDim2.new(0, 200, 0, 30)
    bb.StudsOffset = Vector3.new(0, 3.2, 0)
    bb.AlwaysOnTop = true
    bb.ResetOnSpawn = false

    local lbl = Instance.new("TextLabel", bb)
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = "discord.gg/k7hub"
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 14
    lbl.TextStrokeTransparency = 0.5
    lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
    lbl.TextXAlignment = Enum.TextXAlignment.Center

    local hue = 0
    RunService.Heartbeat:Connect(function(dt)
        hue = (hue + dt * 0.18) % 1
        lbl.TextColor3 = Color3.fromHSV(hue, 0.55, 0.92)
    end)
end

local char = Players.LocalPlayer.Character or Players.LocalPlayer.CharacterAdded:Wait()
task.spawn(function() spawnDiscordTag(char) end)
Players.LocalPlayer.CharacterAdded:Connect(function(c) task.wait(0.5); spawnDiscordTag(c) end)
