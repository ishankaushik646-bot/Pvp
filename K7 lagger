local function makePCSwitch(yPos, labelText, modeName)
    local rowBg = Instance.new("Frame", pcContainer)
    rowBg.Size               = UDim2.new(1, -ROW_PAD_X*2, 0, ROW_H)
    rowBg.Position           = UDim2.new(0, ROW_PAD_X, 0, yPos)
    rowBg.BackgroundColor3   = UI.RowBg
    rowBg.BackgroundTransparency = 0.2
    rowBg.BorderSizePixel    = 0
    rowBg.ZIndex             = 3
    Instance.new("UICorner", rowBg).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel", rowBg)
    lbl.Size                 = UDim2.new(0.65, 0, 1, 0)
    lbl.Position             = UDim2.new(0, 8, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text                 = labelText
    lbl.TextColor3           = UI.TextColor
    lbl.Font                 = UI.Font
    lbl.TextSize             = 11
    lbl.TextXAlignment       = Enum.TextXAlignment.Left
    lbl.TextYAlignment       = Enum.TextYAlignment.Center
    lbl.ZIndex               = 4

    local track = Instance.new("Frame", rowBg)
    track.Size             = UDim2.new(0, SW_TRACK_W, 0, SW_TRACK_H)
    track.Position         = UDim2.new(1, -(SW_TRACK_W + 8), 0.5, -SW_TRACK_H/2)
    track.BackgroundColor3 = UI.TrackOff
    track.BorderSizePixel  = 0
    track.ZIndex           = 4
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local ball = Instance.new("Frame", track)
    ball.Size             = UDim2.new(0, SW_BALL_S, 0, SW_BALL_S)
    ball.Position         = UDim2.new(0, 2, 0.5, -SW_BALL_S/2)
    ball.BackgroundColor3 = UI.BallOff
    ball.BorderSizePixel  = 0
    ball.ZIndex           = 5
    Instance.new("UICorner", ball).CornerRadius = UDim.new(1, 0)

    local swClick = Instance.new("TextButton", rowBg)
    swClick.Size               = UDim2.new(1, 0, 1, 0)
    swClick.BackgroundTransparency = 1
    swClick.Text               = ""
    swClick.ZIndex             = 6

    local function refresh()
        local on = (currentLevel == modeName)
        TweenService:Create(track, TweenInfo.new(0.18), {
            BackgroundColor3 = on and UI.TrackOn or UI.TrackOff
        }):Play()
        TweenService:Create(ball, TweenInfo.new(0.18, Enum.EasingStyle.Back), {
            Position         = on
                and UDim2.new(1, -(SW_BALL_S + 2), 0.5, -SW_BALL_S/2)
                or  UDim2.new(0, 2, 0.5, -SW_BALL_S/2),
            BackgroundColor3 = on and UI.BallOn or UI.BallOff
        }):Play()
    end

    swClick.MouseButton1Click:Connect(function()
        if currentLevel == modeName then return end
        currentLevel = modeName
        for _, sw in ipairs(pcSwitches) do sw.refresh() end
        saveConfig()
    end)

    local entry = { refresh = refresh }
    table.insert(pcSwitches, entry)
    refresh()
    return entry
end

