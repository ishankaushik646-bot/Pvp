mobToggleClick.Text = ""
mobToggleClick.ZIndex = 6

local function setMobToggleVisual(on)
    TweenService:Create(mobBall, TweenInfo.new(0.2, Enum.EasingStyle.Back), {
        Position = on and UDim2.new(1, -(MOB_BALL + 3), 0.5, -MOB_BALL/2) or UDim2.new(0, 3, 0.5, -MOB_BALL/2),
        BackgroundColor3 = on and UI.BallOn or UI.BallOff,
    }):Play()
    TweenService:Create(mobTrack, TweenInfo.new(0.2), {
        BackgroundColor3 = on and UI.TrackOn or UI.TrackOff,
    }):Play()
end

mobToggleClick.MouseButton1Click:Connect(function()
    laggerActive = not laggerActive
    setMobToggleVisual(laggerActive)
    setToggleVisual(laggerActive)
    if laggerActive then
        if lagThread then task.cancel(lagThread) end
        lagThread = task.spawn(function()
            while laggerActive do
                pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(80000) end)
                fireLag(LEVELS[currentLevel].power)
                task.wait(0.18)
            end
        end)
    else
        if lagThread then task.cancel(lagThread); lagThread = nil end
    end
end)

local function refreshAllModeSwitches()
    for _, sw in ipairs(pcSwitches)  do sw.refresh() end
    for _, b  in ipairs(mobBtns)     do b.refresh()  end
end

local function setToggleVisual(on)
    local targetBallX = on and UDim2.new(1, -(BALL_S + 3), 0.5, -BALL_S/2) or UDim2.new(0, 3, 0.5, -BALL_S/2)
    TweenService:Create(pcBall, TweenInfo.new(0.2, Enum.EasingStyle.Back), {
        Position         = targetBallX,
        BackgroundColor3 = on and UI.BallOn or UI.BallOff,
    }):Play()
    TweenService:Create(pcTrack, TweenInfo.new(0.2), {
        BackgroundColor3 = on and UI.TrackOn or UI.TrackOff,
    }):Play()
end

local function toggleLagger()
    laggerActive = not laggerActive
    setToggleVisual(laggerActive)
    if setMobToggleVisual then pcall(function() setMobToggleVisual(laggerActive) end) end
    if laggerActive then
        if lagThread then task.cancel(lagThread) end
        lagThread = task.spawn(function()
            while laggerActive do
                pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(80000) end)
                fireLag(LEVELS[currentLevel].power)
                task.wait(0.18)
            end
        end)
    else
        if lagThread then task.cancel(lagThread); lagThread = nil end
    end
end

pcToggleClick.MouseButton1Click:Connect(toggleLagger)

local function setModeHighlight(mobile)
    TweenService:Create(modeHighlight, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
        Position = mobile
            and UDim2.new(0.5, 1, 0, 2)
            or  UDim2.new(0,   1, 0, 2)
    }):Play()
    TweenService:Create(pcLabel, TweenInfo.new(0.15), {
        TextColor3 = mobile and Color3.fromRGB(90,90,95) or Color3.fromRGB(210,210,215)
    }):Play()
    TweenService:Create(mobLabel, TweenInfo.new(0.15), {
        TextColor3 = mobile and Color3.fromRGB(210,210,215) or Color3.fromRGB(90,90,95)
    }):Play()
end

local function refreshLayout()
    local targetH = isMobile and PH_MOBILE or PH_PC
    TweenService:Create(mainFrame, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, PW, 0, targetH)
    }):Play()
    mainFrame.Position        = UDim2.new(0.15, 0, 0.5, -targetH/2)
    pcContainer.Visible       = not isMobile
    mobileContainer.Visible   = isMobile
    lockButton.Visible        = isMobile
    setModeHighlight(isMobile)
end

pcClick.MouseButton1Click:Connect(function()
    if not isMobile then return end
    isMobile = false
    saveConfig(); refreshLayout()
end)
mobClick.MouseButton1Click:Connect(function()
    if isMobile then return end
    isMobile = true
    saveConfig(); refreshLayout()
end)

UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if listeningForKey then return end
    if inp.KeyCode == keybind then
        toggleLagger()
    end
end)

pcContainer.Visible     = not isMobile
