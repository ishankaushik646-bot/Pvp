local function fakeRootIsUsable()
    local fake = runtime.fakeRoot
    if not isBasePart(fake) then
        return false
    end
    return fake.Parent ~= nil
end

local function destroyFakeRoot()
    if runtime.fakeRoot then
        pcall(function()
            runtime.fakeRoot:Destroy()
        end)
        runtime.fakeRoot = nil
    end
end

local function createFakeRoot(realRoot)
    destroyFakeRoot()
    local fake = realRoot:Clone()
    fake.Name = FAKE_ROOT_NAME
    fake.CanCollide = false
    fake.Massless = true
    fake.Transparency = 1
    fake.Anchored = true
    fake.CFrame = CFrame.new(0, FAKE_ROOT_Y, 0)
    fake.Velocity = FAKE_ROOT_VELOCITY
    fake.Parent = Workspace
    runtime.fakeRoot = fake
    return fake
end

local function assignFakeReplicationRoot(realRoot, fakeRoot)
    if not isBasePart(realRoot) or not isBasePart(fakeRoot) then
        return false
