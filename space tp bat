local function getMyRootPart()
	local character = localPlayer.Character
	if not character then return nil end
	return character:FindFirstChild("HumanoidRootPart")
end

local function getMyHumanoid()
	local character = localPlayer.Character
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end

local function isBatTool(tool)
	if not tool or not tool:IsA("Tool") then return false end
	local n = string.lower(tool.Name)
	return n == "bat" or string.find(n, "bat", 1, true) ~= nil
end

local function getBat()
	local character = localPlayer.Character
	if not character then return nil end
	for _, child in ipairs(character:GetChildren()) do
		if isBatTool(child) then return child end
	end
	local backpack = localPlayer:FindFirstChild("Backpack")
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if isBatTool(child) then
				pcall(function() child.Parent = character end)
				return child
			end
		end
	end
	return nil
end

local function tryHitBat()
	if programState.hittingCooldown then return end
	programState.hittingCooldown = true
	task.spawn(function()
		local bat = getBat()
		if bat then
			for _ = 1, 3 do
				pcall(function() bat:Activate() end)
				for _, d in ipairs(bat:GetDescendants()) do
					if d:IsA("RemoteEvent") then
						pcall(function() d:FireServer() end)
					end
				end
				local re = bat:FindFirstChildWhichIsA("RemoteEvent")
				if re then pcall(function() re:FireServer() end) end
				task.wait(0.025)
			end
		end
		task.wait(settings.autoBatDelay)
		programState.hittingCooldown = false
	end)
end

local function isValidEnemy(player)
	local config = getActiveConfig()
	if player == localPlayer then return false end
	if not player.Character then return false end
	local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	if config.healthCheck and humanoid.Health <= 0 then return false end
	if config.teamCheck then
		if player.Team == localPlayer.Team and player.Team ~= nil then
			return false
		end
	end
	local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return false end
	return true, rootPart, humanoid
end

local function predictPosition(rootPart)
	local config = getActiveConfig()
	if not config.predictMovement then return rootPart.Position end
	local v = rootPart.AssemblyLinearVelocity
	-- only horizontal prediction — vertical velocity caused void issues
	return rootPart.Position + Vector3.new(v.X, 0, v.Z) * config.predictionFactor
end

local function findNearestEnemy()
	local config = getActiveConfig()
	local myRootPart = getMyRootPart()
	if not myRootPart then return nil end
	local nearestRootPart = nil
	local shortestDist = config.range
	for _, player in ipairs(Players:GetPlayers()) do
		local valid, rootPart = isValidEnemy(player)
		if valid then
			local dist = (rootPart.Position - myRootPart.Position).Magnitude
			if dist < shortestDist and dist > 0.5 then
				shortestDist = dist
				nearestRootPart = rootPart
			end
		end
	end
	return nearestRootPart
end

local function teleportTo(targetRootPart)
	local config = getActiveConfig()
	local myRootPart = getMyRootPart()
	local myHumanoid = getMyHumanoid()
	if not myRootPart or not targetRootPart or not targetRootPart.Parent then return end

	local targetPos = predictPosition(targetRootPart)
	if typeof(targetPos) ~= "Vector3" then return end
	if targetPos.X ~= targetPos.X then return end -- NaN check

	local finalPos
	if config.behindTarget then
		local flat = Vector3.new(targetPos.X - myRootPart.Position.X, 0, targetPos.Z - myRootPart.Position.Z)
		if flat.Magnitude < 0.1 then flat = Vector3.new(0, 0, -1) else flat = flat.Unit end
		finalPos = targetPos - flat * config.behindDistance + Vector3.new(0, 1.5, 0)
	elseif config.sideOffset and config.sideOffset > 0 then
		-- V1: stand beside target, face them — bat reach
		local dir = Vector3.new(myRootPart.Position.X - targetPos.X, 0, myRootPart.Position.Z - targetPos.Z)
		if dir.Magnitude < 0.1 then
			dir = Vector3.new(1, 0, 0)
		else
			dir = dir.Unit
		end
		finalPos = targetPos + dir * config.sideOffset
		finalPos = Vector3.new(finalPos.X, targetPos.Y, finalPos.Z) -- lock Y to target (no void)
	else
		-- V2: same XZ-ish, slight above target root
		local yOff = config.tpOffset and config.tpOffset.Y or 1.5
		yOff = math.clamp(yOff, 0.5, 2.5)
		finalPos = Vector3.new(targetPos.X, targetPos.Y + yOff, targetPos.Z)
	end

	-- hard anti-void
	if finalPos.Y < targetPos.Y - 2 then
		finalPos = Vector3.new(finalPos.X, targetPos.Y + 1, finalPos.Z)
	end
	if finalPos.Y > targetPos.Y + 6 then
		finalPos = Vector3.new(finalPos.X, targetPos.Y + 2, finalPos.Z)
	end

	local newCFrame
	if config.smartRotation then
		local lookAt = Vector3.new(targetPos.X, finalPos.Y, targetPos.Z)
		newCFrame = CFrame.new(finalPos, lookAt)
	else
		newCFrame = CFrame.new(finalPos)
	end

	pcall(function()
		myRootPart.AssemblyLinearVelocity = Vector3.zero
		myRootPart.AssemblyAngularVelocity = Vector3.zero
		myRootPart.CFrame = newCFrame
		myRootPart.AssemblyLinearVelocity = Vector3.zero
		myRootPart.AssemblyAngularVelocity = Vector3.zero
	end)

	if config.resetVelocity then
		pcall(function()
			myRootPart.Velocity = Vector3.zero
			myRootPart.AssemblyLinearVelocity = Vector3.zero
			myRootPart.RotVelocity = Vector3.zero
			myRootPart.AssemblyAngularVelocity = Vector3.zero
		end)
	end
	if config.antiFling and myHumanoid then
		pcall(function()
			myHumanoid.PlatformStand = false
			myHumanoid.Sit = false
		end)
	end
end

local function updateStatusUI(isActive)
	if programState.uiReferences.StatusLabel then
		if isActive then
			programState.uiReferences.StatusLabel.Text = "ACTIVE"
			programState.uiReferences.StatusLabel.TextColor3 = GREEN
			if programState.uiReferences.StatusDot then
				programState.uiReferences.StatusDot.BackgroundColor3 = GREEN
			end
		else
			programState.uiReferences.StatusLabel.Text = "INACTIVE"
			programState.uiReferences.StatusLabel.TextColor3 = RED
			if programState.uiReferences.StatusDot then
				programState.uiReferences.StatusDot.BackgroundColor3 = RED
			end
		end
	end
end

local function startTpBat()
	if programState.isRunning then return end
	programState.isRunning = true
	programState.isTpBatActive = true
	programState.tpLoopThread = task.spawn(function()
		while programState.isTpBatActive do
			local target = findNearestEnemy()
			if target then
				teleportTo(target)
				if settings.autoBatEnabled then
					tryHitBat()
				end
			else
				getBat()
			end
			task.wait(getActiveConfig().loopDelay)
		end
	end)
	updateStatusUI(true)
end

local function stopTpBat()
	if not programState.isRunning then return end
	programState.isRunning = false
	programState.isTpBatActive = false
	if programState.tpLoopThread then
		pcall(function() task.cancel(programState.tpLoopThread) end)
		programState.tpLoopThread = nil
	end
	updateStatusUI(false)
end

local function toggleTpBat()
	if programState.isTpBatActive then stopTpBat() else startTpBat() end
end

