-- BAT
-- ============================================================
local function getBat()
    local char = LP.Character
    if not char then return nil end
    local tool = char:FindFirstChild("Bat")
    if tool then return tool end
    local bp2 = LP:FindFirstChild("Backpack")
    if bp2 then
        tool = bp2:FindFirstChild("Bat")
        if tool then tool.Parent = char; return tool end
    end
    return nil
end

local function getClosestPlayer()
    if not hrp then return nil end
    local cp, cd = nil, math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local tr = p.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = p.Character:FindFirstChild("Humanoid")
            if tr and targetHum and targetHum.Health > 0 then
                local d = (hrp.Position - tr.Position).Magnitude
                if d < cd then cd = d; cp = p end
            end
        end
    end
    return cp
end

-- TP + spin around target (better hit chance from multiple angles)
local function tpAndSpin(dt)
    if not hrp then return end
    local target = getClosestPlayer()
    if not target or not target.Character then return end
    local tr = target.Character:FindFirstChild("HumanoidRootPart")
    if not tr then return end

    spinAngle = spinAngle + (SPIN_SPEED * dt)

    local orbitPos = tr.Position + Vector3.new(
        math.cos(spinAngle) * SPIN_RADIUS,
        0.9,
        math.sin(spinAngle) * SPIN_RADIUS
    )
    local lookAt = Vector3.new(tr.Position.X, orbitPos.Y, tr.Position.Z)

    -- Only snap if we've drifted away; otherwise just rotate to face target
    if (hrp.Position - orbitPos).Magnitude > PERF.TP_MIN_DISTANCE then
        pcall(function()
            hrp.CFrame = CFrame.new(orbitPos, lookAt)
            hrp.Velocity = Vector3.zero
            hrp.AssemblyLinearVelocity = Vector3.zero
        end)
    else
        pcall(function()
            hrp.CFrame = CFrame.new(hrp.Position, lookAt)
        end)
    end
end

local function tryHitBat()
    if State.hittingCooldown then return end
    State.hittingCooldown = true
    pcall(function()
        local bat = getBat()
        if bat then
            bat:Activate()
            local ev = bat:FindFirstChildWhichIsA("RemoteEvent")
            if ev then ev:FireServer() end
        end
    end)
    task.delay(PERF.HitDelay, function() State.hittingCooldown = false end)
end

