-- ============================================================
-- MAIN LOOP
--   tp + spin + hit throttled to reduce lag.
--   Screen shake is separate and only active when:
--     tp bat ON  +  shake ON
-- ============================================================
local lastUpdate = 0

RunService.RenderStepped:Connect(function(dt)
    -- Screen shake (independent of TP throttle so it feels smooth)
    if State.autoBatToggled and State.shakeEnabled and Camera then
        shakeTime = shakeTime + dt * SHAKE_SPEED
        local xOff = math.sin(shakeTime) * SHAKE_MAG * 0.01
        local yOff = math.cos(shakeTime * 1.3) * SHAKE_MAG * 0.01
        -- Write CFrame offset directly on top of whatever the camera does
        pcall(function()
            Camera.CFrame = Camera.CFrame * CFrame.new(xOff, yOff, 0)
        end)
    end
end)

task.spawn(function()
    while gui.Parent do
        local dt = task.wait(PERF.TP_THROTTLE)
        if State.autoBatToggled and h and hrp then
            pcall(tpAndSpin, dt)
            pcall(tryHitBat)
        end
    end
end)

