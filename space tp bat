-- ============================================================
-- MINIMAL ANTI-CHEAT PROTECTION (kept light)
-- ============================================================
task.spawn(function()
    task.wait(2)

    local newcclosure      = newcclosure      or function(f) return f end
    local getrawmetatable  = getrawmetatable  or function() return {} end
    local setreadonly      = setreadonly      or function() end
    local getnamecallmethod= getnamecallmethod or function() return "" end
    local hookfunction     = hookfunction     or function(o, n) return o end
    local checkcaller      = checkcaller      or function() return false end
    local getrenv          = getrenv          or function() return getfenv(0) end

    pcall(function()
        local mt = getrawmetatable(game)
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod() == "Kick" and self == LP then
                return task.wait(9e9)
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end)

    pcall(function()
        local env = getrenv()
        local baseMem = 0
        pcall(function() baseMem = gcinfo() end)
        if env.gcinfo then
            local oldGcinfo = env.gcinfo
            hookfunction(oldGcinfo, newcclosure(function(...)
                if not checkcaller() then return baseMem + math.random(-100, 100) end
                return oldGcinfo(...)
            end))
        end
        if env.collectgarbage then
            local oldCG = env.collectgarbage
            hookfunction(oldCG, newcclosure(function(...)
                local args = {...}
                if not checkcaller() and args[1] == "count" then
                    return baseMem + math.random(-100, 100)
                end
                return oldCG(...)
            end))
        end
    end)
end)

