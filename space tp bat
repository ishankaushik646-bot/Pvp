-- Bat TP logic
local batTpEnabled = false
local orbitConn = nil
local attacking = false
local lastAttack = 0
local angle = 0

local function findBatTool()
    local char = localPlayer.Character
    if not char then return nil end

    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and (child.Name:lower():find("bat") or child.Name:lower():find("club")) then
            return child
        end
    end

    local backpack = localPlayer:FindFirstChild("Backpack") or localPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") and (child.Name:lower():find("bat") or child.Name:lower():find("club")) then
                return child
            end
        end
    end
    return nil
end

local function findClosestEnemyRoot()
    local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local closestDist = math.huge
    local closestRoot = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (root.Position - myRoot.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestRoot = root
                end
            end
        end
    end
    return closestRoot
end

local function startOrbit()
    if orbitConn then
        pcall(function() orbitConn:Disconnect() end)
        orbitConn = nil
    end
    attacking = false
    lastAttack = 0
    angle = 0

    orbitConn = RunService.Heartbeat:Connect(function(dt)
        if not batTpEnabled then return end

        local char = localPlayer.Character
        if not char then return end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end

        local tool = char:FindFirstChildOfClass("Tool") or findBatTool()
        if tool and tool.Parent ~= char then
            pcall(function()
                humanoid:EquipTool(tool)
            end)
        end

        local enemyRoot = findClosestEnemyRoot()
        if not enemyRoot then return end

        -- faster orbit (was 7 in original)
        angle = angle + 14 * dt
        if angle > 6.2831853071795862 then
            angle = angle - 6.2831853071795862
        end

        local pos = enemyRoot.Position
        local orbitPos = Vector3.new(
            pos.X + math.cos(angle) * 3.5,
            pos.Y + 0.5,
            pos.Z + math.sin(angle) * 3.5
        )

        hrp.CFrame = CFrame.lookAt(orbitPos, Vector3.new(pos.X, orbitPos.Y, pos.Z))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(pos.X, hrp.Position.Y, pos.Z))

        if tool and not attacking then
            local now = tick()
            if now - lastAttack >= 0.08 then
                attacking = true
                lastAttack = now
                pcall(function()
                    tool:Activate()
                end)
                task.delay(0.08, function()
                    attacking = false
                end)
            end
        end
    end)
end

local function stopOrbit()
    if orbitConn then
        pcall(function() orbitConn:Disconnect() end)
        orbitConn = nil
    end
    attacking = false

    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

local function updateSwitchVisual(enabled, animate)
    local info = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local knobPos = enabled and UDim2.new(0, 27, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
    local bgColor = enabled and Color3.fromRGB(46, 214, 116) or Color3.fromRGB(30, 42, 34)
    local knobColor = enabled and Color3.fromRGB(10, 14, 11) or Color3.fromRGB(200, 212, 204)
    local strokeColor = enabled and Color3.fromRGB(46, 214, 116) or Color3.fromRGB(255, 255, 255)
    local strokeTrans = enabled and 0.55 or 0.9

    if animate then
        TweenService:Create(switchBg, info, { BackgroundColor3 = bgColor }):Play()
        TweenService:Create(switchStroke, info, { Color = strokeColor, Transparency = strokeTrans }):Play()
        TweenService:Create(switchKnob, info, { Position = knobPos, BackgroundColor3 = knobColor }):Play()
        TweenService:Create(toggleLabel, info, {
            TextColor3 = enabled and Color3.fromRGB(140, 255, 180) or Color3.fromRGB(233, 242, 236)
        }):Play()
    else
        switchBg.BackgroundColor3 = bgColor
        switchStroke.Color = strokeColor
        switchStroke.Transparency = strokeTrans
        switchKnob.Position = knobPos
        switchKnob.BackgroundColor3 = knobColor
        toggleLabel.TextColor3 = enabled and Color3.fromRGB(140, 255, 180) or Color3.fromRGB(233, 242, 236)
    end
end

local function setBatTp(enabled)
    batTpEnabled = enabled
    updateSwitchVisual(enabled, true)
    if enabled then
        startOrbit()
    else
        stopOrbit()
    end
end

toggleBtn.MouseButton1Click:Connect(function()
    setBatTp(not batTpEnabled)
end)

-- Keybind
local capturingKeybind = false

local function inputToKeybind(input)
    if input.KeyCode ~= Enum.KeyCode.Unknown then
        return { Type = "Keyboard", Name = input.KeyCode.Name, Value = input.KeyCode.Value }
    end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        return { Type = "Mouse", Name = "M1", Value = 1 }
    end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        return { Type = "Mouse", Name = "M2", Value = 2 }
    end
    if input.UserInputType == Enum.UserInputType.MouseButton3 then
        return { Type = "Mouse", Name = "M3", Value = 3 }
    end
    if input.UserInputType == Enum.UserInputType.Gamepad1 then
        return {
            Type = "Gamepad",
            Name = "Button" .. tostring(input.KeyCode.Value),
            Value = input.KeyCode.Value,
        }
    end
    return nil
end

local function refreshKeybindText()
    keybindBtn.Text = "[" .. getKeybindName() .. "]"
end

keybindBtn.MouseButton1Click:Connect(function()
    if capturingKeybind then return end
    capturingKeybind = true
    keybindBtn.Text = "[?]"
    keybindBtn.TextColor3 = Color3.fromRGB(255, 255, 100)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if capturingKeybind then
        local kb = inputToKeybind(input)
        if kb then
            settings.keybind = kb
            settings.keybindType = kb.Type
            capturingKeybind = false
            keybindBtn.TextColor3 = Color3.fromRGB(46, 214, 116)
            refreshKeybindText()
        end
        return
    end

    if gameProcessed then return end
    if not settings.keybind then return end

    if settings.keybind.Type == "Keyboard" then
        if input.KeyCode.Value == settings.keybind.Value then
            setBatTp(not batTpEnabled)
        end
    elseif settings.keybind.Type == "Mouse" then
        if input.UserInputType == Enum.UserInputType.MouseButton1 and settings.keybind.Value == 1 then
            setBatTp(not batTpEnabled)
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 and settings.keybind.Value == 2 then
            setBatTp(not batTpEnabled)
        elseif input.UserInputType == Enum.UserInputType.MouseButton3 and settings.keybind.Value == 3 then
            setBatTp(not batTpEnabled)
        end
    elseif settings.keybind.Type == "Gamepad" then
        if input.KeyCode.Value == settings.keybind.Value then
            setBatTp(not batTpEnabled)
        end
    end
end)

