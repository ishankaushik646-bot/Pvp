UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if programState.isWaitingForKey then return end
	if input.KeyCode == settings.toggleKey then
		toggleTpBat()
		if programState.uiReferences.TpSwitch and programState.uiReferences.TpKnob then
			local on = programState.isTpBatActive
			if on then
				tween(programState.uiReferences.TpKnob, {Position = UDim2.new(1, -21, 0.5, -9), BackgroundColor3 = ACCENT}, 0.18)
				tween(programState.uiReferences.TpSwitch, {BackgroundColor3 = ACCENT_DIM}, 0.18)
			else
				tween(programState.uiReferences.TpKnob, {Position = UDim2.new(0, 3, 0.5, -9), BackgroundColor3 = TEXT_DIM}, 0.18)
				tween(programState.uiReferences.TpSwitch, {BackgroundColor3 = Color3.fromRGB(40, 16, 24)}, 0.18)
			end
		end
	end
	if input.KeyCode == settings.antiDieKey then
		toggleAntiDie()
		if programState.uiReferences.AntiSwitch and programState.uiReferences.AntiKnob then
			local on = antiDieEnabled
			if on then
				tween(programState.uiReferences.AntiKnob, {Position = UDim2.new(1, -21, 0.5, -9), BackgroundColor3 = ACCENT}, 0.18)
				tween(programState.uiReferences.AntiSwitch, {BackgroundColor3 = ACCENT_DIM}, 0.18)
			else
