    }):Play()
    TweenService:Create(stroke,TweenInfo.new(0.15),{
        Color = on and C.actBrd or C.brd
    }):Play()
    btn.Text = on and "VIOLENCIA\nON" or "VIOLENCIA\nLAGGER"
end

