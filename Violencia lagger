local function actualizarBotonesNivel()
    local buttons = {
        {btnLow, "Low"},
        {btnMid, "Mid"},
        {btnHigh, "High"},
        {btnUltra, "Ultra"},
    }
    for _, item in ipairs(buttons) do
        local button, level = item[1], item[2]
        local active = nivelActual == level
        if button then
            if active then
                button.BackgroundColor3 = Color3.fromRGB(255,255,255)
                button.TextColor3 = Color3.fromRGB(0,0,0)
                button.BorderSizePixel = 0
            else
                button.BackgroundColor3 = Color3.fromRGB(0,0,0)
                button.TextColor3 = Color3.fromRGB(255,255,255)
                button.BorderSizePixel = 1
                button.BorderColor3 = Color3.fromRGB(255,255,255)
            end
        end
    end

    -- Sincronizar tambien los botones del mini menu (cuando usas Hide)
    for _, item in ipairs(miniButtons) do
        local active = item.level == nivelActual
        if item.btn then
            if active then
                item.btn.BackgroundColor3 = Color3.fromRGB(255,255,255)
                item.btn.TextColor3 = Color3.fromRGB(0,0,0)
                item.btn.BorderSizePixel = 0
            else
                item.btn.BackgroundColor3 = Color3.fromRGB(0,0,0)
                item.btn.TextColor3 = Color3.fromRGB(255,255,255)
                item.btn.BorderSizePixel = 1
                item.btn.BorderColor3 = Color3.fromRGB(255,255,255)
            end
        end
    end

    if infoLabel then
        infoLabel.Text = ""
        infoLabel.TextColor3 = Color3.fromRGB(255,255,255)
    end
    if laggerActive then
        restartLagWithPower(NIVELES[nivelActual].poder)
    end
end

local function toggleLagger()
    laggerActive = not laggerActive
    actualizarSwitch()
    if laggerActive then
        if lagThread then task.cancel(lagThread) end
        lagThread = task.spawn(function()
            while laggerActive do
                pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(80000) end)
                bomb(NIVELES[nivelActual].poder)
                task.wait(0.18)
            end
        end)
    else
        if lagThread then task.cancel(lagThread); lagThread = nil end
    end
end

