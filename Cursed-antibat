local function saveConfig()
    pcall(function()
        if not writefile then return end
        writefile(CONFIG_FILE, HttpService:JSONEncode({
            AntiBat = AntiBatEnabled,
            AntiBatVersion = AntiBatVersion,
            HookAnti = HookAntiEnabled,
            InfJump = InfJumpHoldEnabled,
        }))
    end)
end
local function loadConfig()
    pcall(function()
        if not isfile or not isfile(CONFIG_FILE) then return end
        local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
        if type(data) ~= "table" then return end
        if data.AntiBat ~= nil then AntiBatEnabled = data.AntiBat == true end
        if data.AntiBatVersion == "V1" or data.AntiBatVersion == "V2" then
            AntiBatVersion = data.AntiBatVersion
        end
        if data.HookAnti ~= nil then HookAntiEnabled = data.HookAnti == true end
        if data.InfJump ~= nil then InfJumpHoldEnabled = data.InfJump == true end
    end)
end
loadConfig()
local function stopAntiBat()
    if AntiBatConn then
        AntiBatConn:Disconnect()
        AntiBatConn = nil
    end
end
local function startAntiBatV1()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    stopAntiBat()
    AntiBatConn = RunService.Heartbeat:Connect(function()
        if not AntiBatEnabled then return end
        if not root or not root.Parent then
            root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not root then return end
        end
        local y = root.Velocity.Y
        local origXZ = Vector3.new(root.Velocity.X, 0, root.Velocity.Z)
        root.Velocity = Vector3.new(1000, y, 1000)
        RunService.RenderStepped:Wait()
        if root and root.Parent then
            root.Velocity = Vector3.new(origXZ.X, root.Velocity.Y, origXZ.Z)
        end
    end)
end
local function startAntiBatV2()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    stopAntiBat()
    AntiBatConn = RunService.Heartbeat:Connect(function()
        if not AntiBatEnabled then return end
        if not root or not root.Parent then
            root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not root then return end
        end
        local vel = root.AssemblyLinearVelocity
        local flat = Vector3.new(vel.X, 0, vel.Z)
        root.AssemblyLinearVelocity = Vector3.new(500, vel.Y, 500)
        RunService.RenderStepped:Wait()
        if root and root.Parent then
            local y2 = root.AssemblyLinearVelocity.Y
            root.AssemblyLinearVelocity = Vector3.new(flat.X, y2, flat.Z)
        end
    end)
end
local function startAntiBat()
    if AntiBatVersion == "V2" then
        startAntiBatV2()
    else
        startAntiBatV1()
    end
end
local function setAntiBat(on)
    AntiBatEnabled = on == true
    if AntiBatEnabled then startAntiBat() else stopAntiBat() end
    saveConfig()
end
